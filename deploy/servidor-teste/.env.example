# Copiar para .env na mesma pasta do docker-compose.yml, no servidor. O .env não vai pro git.

# Versão da imagem que o servidor roda. Atualizar = trocar aqui + `docker compose up -d`.
AXCTG3_VERSAO=1.0.0

# Senha do usuário postgres. Só vale na PRIMEIRA subida com o volume vazio — depois disso,
# mudar aqui não muda a senha do banco (ver docs/SERVIDOR-TESTE.md).
DB_SENHA=troque-esta-senha
