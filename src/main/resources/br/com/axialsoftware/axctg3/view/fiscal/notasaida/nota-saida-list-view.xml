<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://notaSaidaListView.title"
      focusComponent="notaSaidasDataGrid">
    <data>
        <collection id="notaSaidasDc"
                    class="br.com.axialsoftware.axctg3.entity.fiscal.NotaSaida">
            <fetchPlan extends="_base">
                <property name="parceiro" fetchPlan="_instance_name"/>
                <property name="natureza" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="notaSaidasDl" readOnly="true">
                <query>
                    <![CDATA[select e from NotaSaida e
                    where e.dataEmissao between :dataEmissaoInicial and :dataEmissaoFinal
                    and e.codEmpresa = :codEmpresa
                    order by e.numero desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="delimitarButton" action="notaSaidasDataGrid.delimitarAction" themeNames="small"/>
                <button id="createButton" action="notaSaidasDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="notaSaidasDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="notaSaidasDataGrid.removeAction" themeNames="small"/>
                <dropdownButton id="notaSaidaAcoesDropdownButton" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.acoesDropdownButton.text" themeNames="small">
                    <items>
                        <actionItem id="emitirNfeItem" ref="notaSaidasDataGrid.emitirNfeAction"/>
                        <actionItem id="emitirDanfeItem" ref="notaSaidasDataGrid.emitirDanfeAction"/>
                        <actionItem id="cancelarNfeItem" ref="notaSaidasDataGrid.cancelarNfeAction"/>
                        <actionItem id="consultarNfeItem" ref="notaSaidasDataGrid.consultarNfeAction"/>
                        <actionItem id="verificarStatusServicoItem" ref="notaSaidasDataGrid.verificarStatusServicoAction"/>
                        <actionItem id="inutilizarNumerosItem" ref="notaSaidasDataGrid.inutilizarNumerosAction"/>
                        <separator/>
                        <actionItem id="alternarAmbienteItem" ref="notaSaidasDataGrid.alternarAmbienteAction"/>
                    </items>
                </dropdownButton>
                <span id="ambienteBadge" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="notaSaidasDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="notaSaidasDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="notaSaidasDc"
                  columnReorderingAllowed="true" themeNames="small">
            <actions>
                <action id="delimitarAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.delimitarAction.text" icon="vaadin:calendar"/>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
                <action id="emitirNfeAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.emitirNfeAction.text" icon="vaadin:paperplane"/>
                <action id="emitirDanfeAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.emitirDanfeAction.text" icon="vaadin:print"/>
                <action id="cancelarNfeAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.cancelarNfeAction.text" icon="vaadin:ban"/>
                <action id="consultarNfeAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.consultarNfeAction.text" icon="vaadin:search"/>
                <action id="verificarStatusServicoAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.verificarStatusServicoAction.text" icon="vaadin:signal"/>
                <action id="inutilizarNumerosAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.inutilizarNumerosAction.text" icon="vaadin:trash"/>
                <action id="alternarAmbienteAction" text="msg://br.com.axialsoftware.axctg3.view.fiscal.notasaida/notaSaidaListView.alternarAmbienteAction.text" icon="vaadin:exchange"/>
            </actions>
            <columns resizable="true">
                <column property="numero" filterable="true" width="9%"/>
                <column property="dataEmissao" filterable="true" width="11%"/>
                <column property="especie" filterable="true" width="7%"/>
                <column property="serie" filterable="true" width="7%"/>
                <column property="parceiro" filterable="true" width="22%"/>
                <column property="natureza" filterable="true" width="19%"/>
                <column property="valor" filterable="true" textAlign="END" width="12%"/>
                <column property="chave" filterable="true" width="13%"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
