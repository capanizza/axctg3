<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://parceiroListView.title"
      focusComponent="parceiroesDataGrid">
    <data>
        <collection id="parceiroesDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.Parceiro">
            <fetchPlan extends="_base"/>
            <loader id="parceiroesDl" readOnly="true">
                <query>
                    <![CDATA[select e from Parceiro e
                        where e.codEmpresa = :codEmpresa
                        order by e.codigo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="parceiroesDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="parceiroesDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="parceiroesDataGrid.removeAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="parceiroesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="parceiroesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="parceiroesDc"
                  columnReorderingAllowed="true" themeNames="small">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="codigo" width="10%"/>
                <column property="nome" width="45%"/>
                <column property="apelido" width="25%"/>
                <column property="cnpj" width="20%"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
