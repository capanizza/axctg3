<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://pedidoVendaListView.title"
      focusComponent="pedidoVendasDataGrid">
    <data>
        <collection id="pedidoVendasDc"
                    class="br.com.axialsoftware.axctg3.entity.fiscal.PedidoVenda">
            <fetchPlan extends="_base">
                <property name="parceiro" fetchPlan="_instance_name"/>
                <property name="natureza" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="pedidoVendasDl" readOnly="true">
                <query>
                    <![CDATA[select e from PedidoVenda e
                    where e.codEmpresa = :codEmpresa
                    and e.dataEntrada between :dataEntradaInicial and :dataEntradaFinal
                    order by e.numero desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="delimitarButton" action="pedidoVendasDataGrid.delimitarAction" themeNames="small"/>
                <button id="createButton" action="pedidoVendasDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="pedidoVendasDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="pedidoVendasDataGrid.removeAction" themeNames="small"/>
                <button id="listagemButton" action="pedidoVendasDataGrid.listagemAction" themeNames="small"/>
                <button id="emitirNotaSaidaButton" action="pedidoVendasDataGrid.emitirNotaSaidaAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="pedidoVendasDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="pedidoVendasDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="pedidoVendasDc"
                  columnReorderingAllowed="true" themeNames="small">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
                <action id="delimitarAction"
                        text="msg://br.com.axialsoftware.axctg3.view.fiscal.pedidovenda/pedidoVendaListView.delimitarAction.text"
                        icon="vaadin:calendar"/>
                <action id="listagemAction"
                        text="msg://br.com.axialsoftware.axctg3.view.fiscal.pedidovenda/pedidoVendaListView.listagemAction.text"
                        icon="PRINT"/>
                <action id="emitirNotaSaidaAction"
                        text="msg://br.com.axialsoftware.axctg3.view.fiscal.pedidovenda/pedidoVendaListView.emitirNotaSaidaAction.text"
                        icon="vaadin:file-add"/>
            </actions>
            <columns resizable="true">
                <column property="numero" filterable="true" width="12%"/>
                <column property="dataEntrada" filterable="true" width="15%"/>
                <column property="parceiro" filterable="true" width="40%"/>
                <column property="natureza" filterable="true" width="33%"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
