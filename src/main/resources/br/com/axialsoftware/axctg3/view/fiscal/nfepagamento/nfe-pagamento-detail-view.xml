<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://nfePagamentoDetailView.title"
      focusComponent="form">
    <data>
        <instance id="nfePagamentoDc"
                  class="br.com.axialsoftware.axctg3.entity.fiscal.NfePagamento">
            <fetchPlan extends="_base"/>
            <loader id="nfePagamentoDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" width="100%">
            <hbox width="100%" expand="descricaoPagField">
                <integerField id="indPagField"
                              property="indPag"
                              dataContainer="nfePagamentoDc"
                              width="14%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.indPag"/>
                <textField id="tipoPagField"
                           property="tipoPag"
                           maxLength="2"
                           dataContainer="nfePagamentoDc"
                           width="14%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.tipoPag"/>
                <textField id="descricaoPagField"
                           property="descricaoPag"
                           maxLength="60"
                           dataContainer="nfePagamentoDc" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.descricaoPag"/>
                <bigDecimalField id="valorPagField"
                                 property="valorPag"
                                 dataContainer="nfePagamentoDc"
                                 width="20%" themeNames="small"
                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.valorPag"/>
            </hbox>
            <hbox width="100%">
                <integerField id="tipoIntegracaoCartaoField"
                              property="tipoIntegracaoCartao"
                              dataContainer="nfePagamentoDc"
                              width="16%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.tipoIntegracaoCartao"/>
                <textField id="cnpjCredenciadoraField"
                           property="cnpjCredenciadora"
                           maxLength="14"
                           dataContainer="nfePagamentoDc"
                           width="20%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.cnpjCredenciadora"/>
                <textField id="bandeiraCartaoField"
                           property="bandeiraCartao"
                           maxLength="2"
                           dataContainer="nfePagamentoDc"
                           width="14%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.bandeiraCartao"/>
                <textField id="numeroAutorizacaoCartaoField"
                           property="numeroAutorizacaoCartao"
                           maxLength="20"
                           dataContainer="nfePagamentoDc"
                           width="22%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfePagamento.numeroAutorizacaoCartao"/>
            </hbox>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
