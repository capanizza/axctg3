<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://tituloPagarListView.title"
      focusComponent="tituloPagarsDataGrid">
    <data>
        <collection id="tituloPagarsDc"
                    class="br.com.axialsoftware.axctg3.entity.financeiro.TituloPagar">
            <fetchPlan extends="_base">
                <property name="parceiro" fetchPlan="_base"/>
                <property name="contaContabil" fetchPlan="_base"/>
                <property name="itens" fetchPlan="_base"/>
                <property name="aberto"/>
                <property name="contabilizadoEmissao"/>
            </fetchPlan>
            <loader id="tituloPagarsDl" readOnly="true">
                <query>
                    <![CDATA[select e from TituloPagar e
                    where e.dataEmissao between :dataEmissaoInicial and :dataEmissaoFinal
                    and e.codEmpresa = :codEmpresa
                    order by e.numero]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="delimitarButton" action="tituloPagarsDataGrid.delimitarAction" themeNames="small"/>
                <button id="createButton" action="tituloPagarsDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="tituloPagarsDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="tituloPagarsDataGrid.removeAction" themeNames="small"/>
                <button id="lancamentoButton" action="tituloPagarsDataGrid.lancamentoAction" themeNames="small"/>
                <dropdownButton id="relatoriosSwitcher"
                                text="Relatórios" icon="PRINT" themeNames="small"
                                dropdownIndicatorVisible="true">
                    <items>
                        <actionItem id="emissaoItem">
                            <action id="emissaoAction"
                                    text="Por data de emissão" icon="PRINT"/>
                        </actionItem>
                        <actionItem id="vencimentoItem">
                            <action id="vencimentoAction"
                                    text="Por data de vencimento" icon="PRINT"/>
                        </actionItem>
                    </items>
                </dropdownButton>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="tituloPagarsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="tituloPagarsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="tituloPagarsDc"
                  columnReorderingAllowed="true"
                  themeNames="small"
                  selectionMode="MULTI">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
                <action id="delimitarAction" text="Delimitar" icon="vaadin:calendar"/>
                <action id="lancamentoAction" text="Lançamentos" type="list_itemTracking" icon="lumo:checkmark"/>
            </actions>
            <columns resizable="true">
                <column property="numero" filterable="true" flexGrow="0"/>
                <column property="documento" filterable="true" flexGrow="0"/>
                <column property="dataEmissao" filterable="true" flexGrow="0"/>
                <column property="dataVencimento" filterable="true" flexGrow="0"/>
                <column property="parceiro" filterable="true" flexGrow="10"/>
                <column property="valor" filterable="true" textAlign="END" flexGrow="0"/>
                <column property="contaContabil" filterable="true"/>
                <column property="aberto" flexGrow="0" textAlign="CENTER"/>
                <column property="contabilizadoEmissao" flexGrow="0" textAlign="CENTER"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
