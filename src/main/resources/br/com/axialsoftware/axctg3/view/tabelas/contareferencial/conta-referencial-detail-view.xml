<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://contaReferencialDetailView.title"
      focusComponent="form">
    <data>
        <instance id="contaReferencialDc"
                  class="br.com.axialsoftware.axctg3.entity.tabelas.ContaReferencial">
            <fetchPlan extends="_base"/>
            <loader id="contaReferencialDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" width="100%">
            <hbox width="100%">
                <select id="codPlanRefField"
                        property="codPlanRef"
                        dataContainer="contaReferencialDc"
                        themeNames="small"
                        width="26%"
                        label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.codPlanRef"/>
                <textField id="codigoField"
                           property="codigo"
                           dataContainer="contaReferencialDc"
                           width="14%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.codigo"/>
                <integerField id="grauField"
                              property="grau"
                              dataContainer="contaReferencialDc"
                              width="10%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.grau"/>
                <select id="codNatField"
                        property="codNat"
                        dataContainer="contaReferencialDc"
                        themeNames="small"
                        width="20%"
                        label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.codNat"/>
                <checkbox id="analiticaField"
                          property="analitica"
                          dataContainer="contaReferencialDc"
                          alignSelf="BASELINE"
                          width="15%"
                          label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.analitica"/>
            </hbox>
            <textField id="descricaoField"
                       property="descricao"
                       dataContainer="contaReferencialDc"
                       width="100%" themeNames="small"
                       label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.descricao"/>
            <hbox width="100%">
                <textField id="codContaSupField"
                           property="codContaSup"
                           dataContainer="contaReferencialDc"
                           width="25%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.codContaSup"/>
                <datePicker id="dtIniField"
                            property="dtIni"
                            dataContainer="contaReferencialDc"
                            width="20%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.dtIni"/>
                <datePicker id="dtFimField"
                            property="dtFim"
                            dataContainer="contaReferencialDc"
                            width="20%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.dtFim"/>
            </hbox>
            <textArea id="orientacoesField"
                      property="orientacoes"
                      dataContainer="contaReferencialDc"
                      width="100%" minRows="3" maxRows="8"
                      label="msg://br.com.axialsoftware.axctg3.entity.tabelas/ContaReferencial.orientacoes"/>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
