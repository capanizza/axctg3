<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://itemDiversoPagarDetailView.title"
      focusComponent="form">
    <data>
        <instance id="itemDiversoPagarDc"
                  class="br.com.axialsoftware.axctg3.entity.financeiro.ItemDiversoPagar">
            <fetchPlan extends="_base">
                <property name="diversoPagar" fetchPlan="_base"/>
                <property name="banco" fetchPlan="_instance_name"/>
                <property name="valorLiquido"/>
            </fetchPlan>
            <loader id="itemDiversoPagarDl"/>
        </instance>
        <collection id="historicosFinanceirosDc"
                    class="br.com.axialsoftware.axctg3.entity.financeiro.HistoricoFinanceiro"
                    fetchPlan="_base">
            <loader id="historicosFinanceirosDl">
                <query>
                    <![CDATA[select e from HistoricoFinanceiro e
                    where e.codEmpresa = :codEmpresa
                    and e.emissao = false
                    and e.baixa = true
                    order by e.codigo]]>
                </query>
            </loader>
        </collection>
        <collection id="bancosDc"
                    class="br.com.axialsoftware.axctg3.entity.financeiro.Banco"
                    fetchPlan="_base">
            <loader id="bancosDl">
                <query>
                    <![CDATA[select e from Banco e
                    where e.codEmpresa = :codEmpresa
                    order by e.codigo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form">
            <hbox width="100%">
                <integerField id="itemField"
                              property="item"
                              dataContainer="itemDiversoPagarDc"
                              width="10%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.item"/>
                <datePicker id="dataField"
                            property="data"
                            dataContainer="itemDiversoPagarDc"
                            width="20%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.data"/>
                <entityComboBox id="historicoFinanceiroField"
                                property="historicoFinanceiro"
                                dataContainer="itemDiversoPagarDc"
                                itemsContainer="historicosFinanceirosDc"
                                width="70%" themeNames="small"
                                label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.historicoFinanceiro"/>
            </hbox>
            <hbox width="60%">
                <entityComboBox id="bancoField"
                                property="banco"
                                dataContainer="itemDiversoPagarDc"
                                itemsContainer="bancosDc"
                                width="100%" themeNames="small"
                                required="true"
                                label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.banco"/>
            </hbox>
            <hbox width="100%">
                <textField id="valorField"
                           property="valor"
                           dataContainer="itemDiversoPagarDc"
                           width="25%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.valor"/>
                <textField id="jurosField"
                           property="juros"
                           dataContainer="itemDiversoPagarDc"
                           width="25%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.juros"/>
                <textField id="descontoField"
                           property="desconto"
                           dataContainer="itemDiversoPagarDc"
                           width="25%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.desconto"/>
                <textField id="valorLiquidoField"
                           property="valorLiquido"
                           dataContainer="itemDiversoPagarDc"
                           width="25%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/ItemDiversoPagar.valorLiquido"/>
            </hbox>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
