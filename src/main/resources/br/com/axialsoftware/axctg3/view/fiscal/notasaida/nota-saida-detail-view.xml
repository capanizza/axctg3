<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://notaSaidaDetailView.title"
      focusComponent="form">
    <data>
        <instance id="notaSaidaDc"
                  class="br.com.axialsoftware.axctg3.entity.fiscal.NotaSaida">
            <fetchPlan extends="_base">
                <property name="itens" fetchPlan="_base">
                    <property name="produto" fetchPlan="_instance_name"/>
                </property>
                <property name="parceiro" fetchPlan="_instance_name"/>
                <property name="natureza" fetchPlan="_instance_name"/>
                <property name="condicaoPagamento" fetchPlan="_instance_name"/>
                <property name="banco" fetchPlan="_instance_name"/>
                <property name="transportadora" fetchPlan="_instance_name"/>
                <property name="vendedor" fetchPlan="_instance_name"/>
                <property name="classTrib" fetchPlan="_base"/>
                <property name="mensagem" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="notaSaidaDl"/>
            <collection id="itensDc" property="itens"/>
        </instance>
        <!-- itemsContainer dos entityComboBox abaixo (troca de entityPicker, ver
             memória do projeto entitypicker-not-entitycombobox); codEmpresa da sessão
             via PreLoadEvent nos que não são tabela global. -->
        <collection id="naturezaOperacoesDc"
                    class="br.com.axialsoftware.axctg3.entity.fiscal.NaturezaOperacao">
            <loader id="naturezaOperacoesDl">
                <query><![CDATA[select e from NaturezaOperacao e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="classTribsDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.ClassTrib">
            <loader id="classTribsDl">
                <query><![CDATA[select e from ClassTrib e order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="condicoesPagamentoDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.CondicaoPagamento">
            <loader id="condicoesPagamentoDl">
                <query><![CDATA[select e from CondicaoPagamento e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="bancosDc"
                    class="br.com.axialsoftware.axctg3.entity.financeiro.Banco">
            <loader id="bancosDl">
                <query><![CDATA[select e from Banco e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="transportadorasDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.Transportadora">
            <loader id="transportadorasDl">
                <query><![CDATA[select e from Transportadora e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="vendedoresDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.Vendedor">
            <loader id="vendedoresDl">
                <query><![CDATA[select e from Vendedor e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="mensagensDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.Mensagem">
            <loader id="mensagensDl">
                <query><![CDATA[select e from Mensagem e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" width="100%" spacing="true">
            <!-- fora das abas: identificação/status da nota, visível em qualquer aba -->
            <hbox width="100%" expand="parceiroField">
                <integerField id="numeroField"
                              property="numero"
                              dataContainer="notaSaidaDc"
                              width="8%" themeNames="small"
                              readOnly="true"
                              label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.numero"/>
                <datePicker id="dataEmissaoField"
                            property="dataEmissao"
                            dataContainer="notaSaidaDc"
                            width="12%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.dataEmissao"/>
                <!-- entityComboBox com busca preguiçosa (itemsFetchCallback, ver
                     NotaSaidaDetailView.parceiroFieldItemsFetchCallback) — não itemsContainer,
                     que carregaria os ~20 mil clientes de uma vez (lento, achado ao vivo
                     2026-09-15). Busca por lote (50 de cada vez) direto no banco, filtrado
                     por cliente=true e pelo texto digitado. -->
                <entityComboBox id="parceiroField"
                                property="parceiro"
                                dataContainer="notaSaidaDc" themeNames="small"
                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.parceiro">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityComboBox>
                <checkbox id="canceladaField"
                          property="cancelada"
                          dataContainer="notaSaidaDc"
                          width="12%"
                          alignSelf="END"
                          label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.cancelada"/>
            </hbox>
            <vbox id="verticalBox" width="100%">
                <tabSheet id="formTabs" width="100%" themeNames="small, bordered">
                    <tab id="informacoesGeraisTab" label="Informações gerais">
                        <vbox width="100%">
                            <hbox width="100%" expand="naturezaField">
                                <textField id="especieField"
                                           property="especie"
                                           maxLength="4"
                                           dataContainer="notaSaidaDc"
                                           width="8%" themeNames="small"
                                           readOnly="true"
                                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.especie"/>
                                <textField id="serieField"
                                           property="serie"
                                           maxLength="2"
                                           dataContainer="notaSaidaDc"
                                           width="5%" themeNames="small"
                                           readOnly="true"
                                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.serie"/>
                                <datePicker id="dataSaidaField"
                                            property="dataSaida"
                                            dataContainer="notaSaidaDc"
                                            width="13%" themeNames="small"
                                            label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.dataSaida"/>
                                <entityComboBox id="naturezaField"
                                                property="natureza"
                                                itemsContainer="naturezaOperacoesDc"
                                                width="36%"
                                                dataContainer="notaSaidaDc" themeNames="small"
                                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.natureza">
                                    <actions>
                                        <action id="entityLookupAction" type="entity_lookup"/>
                                        <action id="entityClearAction" type="entity_clear"/>
                                    </actions>
                                </entityComboBox>
                                <entityComboBox id="classTribField"
                                                property="classTrib"
                                                itemsContainer="classTribsDc"
                                                dataContainer="notaSaidaDc"
                                                width="36%" themeNames="small"
                                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.classTrib">
                                    <actions>
                                        <action id="entityLookupAction" type="entity_lookup"/>
                                        <action id="entityClearAction" type="entity_clear"/>
                                    </actions>
                                </entityComboBox>
                            </hbox>
                            <hbox width="100%">
                                <entityComboBox id="condicaoPagamentoField"
                                                property="condicaoPagamento"
                                                itemsContainer="condicoesPagamentoDc"
                                                dataContainer="notaSaidaDc"
                                                width="25%" themeNames="small"
                                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.condicaoPagamento">
                                    <actions>
                                        <action id="entityLookupAction" type="entity_lookup"/>
                                        <action id="entityClearAction" type="entity_clear"/>
                                    </actions>
                                </entityComboBox>
                                <entityComboBox id="bancoField"
                                                property="banco"
                                                itemsContainer="bancosDc"
                                                dataContainer="notaSaidaDc"
                                                width="25%" themeNames="small"
                                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.banco">
                                    <actions>
                                        <action id="entityLookupAction" type="entity_lookup"/>
                                        <action id="entityClearAction" type="entity_clear"/>
                                    </actions>
                                </entityComboBox>
                                <entityComboBox id="transportadoraField"
                                                property="transportadora"
                                                itemsContainer="transportadorasDc"
                                                dataContainer="notaSaidaDc"
                                                width="25%" themeNames="small"
                                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.transportadora">
                                    <actions>
                                        <action id="entityLookupAction" type="entity_lookup"/>
                                        <action id="entityClearAction" type="entity_clear"/>
                                    </actions>
                                </entityComboBox>
                                <entityComboBox id="vendedorField"
                                                property="vendedor"
                                                itemsContainer="vendedoresDc"
                                                dataContainer="notaSaidaDc"
                                                width="25%" themeNames="small"
                                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.vendedor">
                                    <actions>
                                        <action id="entityLookupAction" type="entity_lookup"/>
                                        <action id="entityClearAction" type="entity_clear"/>
                                    </actions>
                                </entityComboBox>
                            </hbox>
                        </vbox>
                    </tab>
                    <tab id="complementosTab" label="Complementos">
                        <vbox width="100%">
                            <hbox width="100%" expand="complementoMensagemField">
                                <entityComboBox id="mensagemField"
                                                property="mensagem"
                                                itemsContainer="mensagensDc"
                                                dataContainer="notaSaidaDc"
                                                width="40%" themeNames="small"
                                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.mensagem">
                                    <actions>
                                        <action id="entityLookupAction" type="entity_lookup"/>
                                        <action id="entityClearAction" type="entity_clear"/>
                                    </actions>
                                </entityComboBox>
                                <textArea id="complementoMensagemField"
                                          property="complementoMensagem"
                                          dataContainer="notaSaidaDc"
                                          height="6.5em" themeNames="small"
                                          label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.complementoMensagem"/>
                            </hbox>
                            <hbox width="100%">
                                <comboBox id="modFreteField"
                                          property="modFrete"
                                          dataContainer="notaSaidaDc"
                                          width="50%" themeNames="small"
                                          label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.modFrete"/>
                            </hbox>
                            <hbox width="100%">
                                <bigDecimalField id="freteField"
                                                 property="frete"
                                                 dataContainer="notaSaidaDc"
                                                 width="16%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.frete"/>
                                <bigDecimalField id="seguroField"
                                                 property="seguro"
                                                 dataContainer="notaSaidaDc"
                                                 width="16%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.seguro"/>
                                <bigDecimalField id="descontoField"
                                                 property="desconto"
                                                 dataContainer="notaSaidaDc"
                                                 width="16%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.desconto"/>
                                <bigDecimalField id="despesasField"
                                                 property="despesas"
                                                 dataContainer="notaSaidaDc"
                                                 width="16%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.despesas"/>
                                <bigDecimalField id="pesoLiquidoField"
                                                 property="pesoLiquido"
                                                 dataContainer="notaSaidaDc"
                                                 width="16%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.pesoLiquido"/>
                                <bigDecimalField id="pesoBrutoField"
                                                 property="pesoBruto"
                                                 dataContainer="notaSaidaDc"
                                                 width="15%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.pesoBruto"/>
                            </hbox>
                            <hbox width="100%">
                                <textField id="chaveField"
                                           property="chave"
                                           dataContainer="notaSaidaDc"
                                           width="50%" themeNames="small"
                                           readOnly="true"
                                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.chave"/>
                                <textField id="chaveTentativaField"
                                           property="chaveTentativa"
                                           dataContainer="notaSaidaDc"
                                           width="50%" themeNames="small"
                                           readOnly="true"
                                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.chaveTentativa"/>
                            </hbox>
                            <hbox width="100%">
                                <comboBox id="finNfeField"
                                          property="finNfe"
                                          dataContainer="notaSaidaDc"
                                          width="30%" themeNames="small"
                                          label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.finNfe"/>
                                <textField id="chaveNotaOriginalField"
                                           property="chaveNotaOriginal"
                                           dataContainer="notaSaidaDc"
                                           maxLength="44"
                                           width="70%" themeNames="small"
                                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.chaveNotaOriginal"/>
                            </hbox>
                        </vbox>
                    </tab>
                    <tab id="itensTab" label="Itens">
                        <vbox width="100%">
                            <hbox id="itensButtonsPanel" classNames="buttons-panel">
                                <button id="itemCreateButton" action="itensNotaSaidaDataGrid.create" themeNames="small"/>
                                <button id="itemEditButton" action="itensNotaSaidaDataGrid.edit" themeNames="small"/>
                                <button id="itemRemoveButton" action="itensNotaSaidaDataGrid.remove" themeNames="small"/>
                            </hbox>
                            <dataGrid id="itensNotaSaidaDataGrid"
                                      dataContainer="itensDc"
                                      width="100%"
                                      height="16em"
                                      themeNames="small">
                                <actions>
                                    <action id="create" type="list_create">
                                        <properties>
                                            <property name="openMode" value="DIALOG"/>
                                        </properties>
                                    </action>
                                    <action id="edit" type="list_edit">
                                        <properties>
                                            <property name="openMode" value="DIALOG"/>
                                        </properties>
                                    </action>
                                    <action id="remove" type="list_remove"/>
                                </actions>
                                <columns resizable="true">
                                    <column property="item" width="8%" textAlign="CENTER"/>
                                    <column property="produto" width="40%"/>
                                    <column property="quantidade" width="14%" textAlign="END"/>
                                    <column property="valorUnitario" width="19%" textAlign="END"/>
                                    <column property="subTotal" width="19%" textAlign="END"/>
                                </columns>
                            </dataGrid>
                        </vbox>
                    </tab>
                    <tab id="valoresCalculadosTab" label="Valores calculados">
                        <vbox width="100%">
                            <hbox width="100%">
                                <bigDecimalField id="valorField"
                                                 property="valor"
                                                 dataContainer="notaSaidaDc"
                                                 readOnly="true"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.valor"/>
                                <bigDecimalField id="valorMercadoriaField"
                                                 property="valorMercadoria"
                                                 dataContainer="notaSaidaDc"
                                                 readOnly="true"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.valorMercadoria"/>
                                <bigDecimalField id="baseIcmsField"
                                                 property="baseIcms"
                                                 dataContainer="notaSaidaDc"
                                                 readOnly="true"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.baseIcms"/>
                                <bigDecimalField id="valorIcmsField"
                                                 property="valorIcms"
                                                 dataContainer="notaSaidaDc"
                                                 readOnly="true"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.valorIcms"/>
                            </hbox>
                            <hbox width="100%">
                                <bigDecimalField id="baseStField"
                                                 property="baseSt"
                                                 dataContainer="notaSaidaDc"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.baseSt"/>
                                <bigDecimalField id="valorStField"
                                                 property="valorSt"
                                                 dataContainer="notaSaidaDc"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.valorSt"/>
                                <bigDecimalField id="baseIpiField"
                                                 property="baseIpi"
                                                 dataContainer="notaSaidaDc"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.baseIpi"/>
                                <bigDecimalField id="valorIpiField"
                                                 property="valorIpi"
                                                 dataContainer="notaSaidaDc"
                                                 width="25%" themeNames="small"
                                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NotaSaida.valorIpi"/>
                            </hbox>
                        </vbox>
                    </tab>
                </tabSheet>
            </vbox>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
