<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://bancoDetailView.title"
      focusComponent="form">
    <data>
        <instance id="bancoDc"
                  class="br.com.axialsoftware.axctg3.entity.financeiro.Banco">
            <fetchPlan extends="_base">
                <property name="contaContabil" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="bancoDl"/>
        </instance>
        <collection id="contaContabilsDc"
                    class="br.com.axialsoftware.axctg3.entity.contabil.ContaContabil"
                    fetchPlan="_base">
            <loader id="contaContabilsDl">
                <query>
                    <![CDATA[select e from ContaContabil e
                    where e.codigo > '1'
                    and e.codEmpresa = :codEmpresa
                    and e.analitica = true
                    and e.ano = :ano
                    order by e.codigo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
