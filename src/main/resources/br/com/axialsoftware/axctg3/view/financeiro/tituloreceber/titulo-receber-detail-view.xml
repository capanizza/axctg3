<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://tituloReceberDetailView.title"
      focusComponent="form">
    <data>
        <instance id="tituloReceberDc"
                  class="br.com.axialsoftware.axctg3.entity.financeiro.TituloReceber">
            <fetchPlan extends="_base">
                <property name="parceiro" fetchPlan="_instance_name"/>
                <property name="banco" fetchPlan="_instance_name"/>
                <property name="itens" fetchPlan="_base">
                    <property name="valorLiquido"/>
                </property>
            </fetchPlan>
            <loader id="tituloReceberDl"/>
            <collection id="itensDc" property="itens"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form">
            <hbox width="100%">
                <textField id="numeroField"
                           property="numero"
                           dataContainer="tituloReceberDc"
                           width="20%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.numero"/>
                <datePicker id="dataEmissaoField"
                            property="dataEmissao"
                            dataContainer="tituloReceberDc"
                            width="20%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.dataEmissao"/>
                <datePicker id="dataVencimentoField"
                            property="dataVencimento"
                            dataContainer="tituloReceberDc"
                            width="20%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.dataVencimento"/>
                <textField id="valorField"
                           property="valor"
                           dataContainer="tituloReceberDc"
                           width="20%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.valor"/>
                <textField id="numBancoField"
                           property="numBanco"
                           dataContainer="tituloReceberDc"
                           width="20%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.numBanco"/>
            </hbox>
            <hbox width="100%">
                <entityPicker id="parceiroField"
                              property="parceiro"
                              dataContainer="tituloReceberDc"
                              width="65%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.parceiro">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
                <entityPicker id="bancoField"
                              property="banco"
                              dataContainer="tituloReceberDc"
                              width="35%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.banco">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
            </hbox>
            <hbox width="65%">
                <textArea id="observacaoField"
                          property="observacao"
                          dataContainer="tituloReceberDc"
                          width="100%" themeNames="small"
                          label="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.observacao"/>
            </hbox>
        </vbox>
        <h4 text="msg://br.com.axialsoftware.axctg3.entity.financeiro/TituloReceber.itens"/>
        <hbox id="itensButtonsPanel" classNames="buttons-panel">
            <button id="itensRemoveButton" action="itensDataGrid.removeAction" themeNames="small"/>
        </hbox>
        <dataGrid id="itensDataGrid" dataContainer="itensDc" width="100%" minHeight="10em" themeNames="small">
            <actions>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="item" flexGrow="0"/>
                <column property="historicoFinanceiro" flexGrow="3"/>
                <column property="data" flexGrow="0"/>
                <column property="valor" textAlign="END" flexGrow="0"/>
                <column property="juros" textAlign="END" flexGrow="0"/>
                <column property="desconto" textAlign="END" flexGrow="0"/>
                <column property="valorLiquido" textAlign="END" flexGrow="0"/>
                <column property="contabilizado" textAlign="CENTER" flexGrow="0"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
