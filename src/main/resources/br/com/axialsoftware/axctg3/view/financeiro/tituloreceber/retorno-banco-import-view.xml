<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://retornoBancoImportView.title">
    <layout>
        <comboBox id="bancoField" width="100%" label="msg://retornoBancoImportView.bancoField.label"/>
        <upload id="retornoUpload"
                width="100%"
                uploadHandlerType="IN_MEMORY"
                maxFiles="1"
                acceptedFileTypes=".txt,.ret,text/plain"
                dropLabel="msg://retornoBancoImportView.upload.dropLabel"
                uploadText="msg://retornoBancoImportView.upload.uploadText"/>
        <hbox id="importActions" width="100%" justifyContent="END" themeNames="spacing">
            <button id="cancelarButton" text="msg://retornoBancoImportView.cancelarButton.text" themeNames="small"/>
            <button id="processarButton" text="msg://retornoBancoImportView.processarButton.text" themeNames="small primary"/>
        </hbox>
    </layout>
</view>
