<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://nfeDuplicataDetailView.title"
      focusComponent="form">
    <data>
        <instance id="nfeDuplicataDc"
                  class="br.com.axialsoftware.axctg3.entity.fiscal.NfeDuplicata">
            <fetchPlan extends="_base"/>
            <loader id="nfeDuplicataDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" width="100%">
            <hbox width="100%">
                <textField id="numDupField"
                           property="numDup"
                           maxLength="60"
                           dataContainer="nfeDuplicataDc"
                           width="34%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfeDuplicata.numDup"/>
                <datePicker id="dataVencField"
                            property="dataVenc"
                            dataContainer="nfeDuplicataDc"
                            width="33%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfeDuplicata.dataVenc"/>
                <bigDecimalField id="valorDupField"
                                 property="valorDup"
                                 dataContainer="nfeDuplicataDc"
                                 width="33%" themeNames="small"
                                 label="msg://br.com.axialsoftware.axctg3.entity.fiscal/NfeDuplicata.valorDup"/>
            </hbox>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
