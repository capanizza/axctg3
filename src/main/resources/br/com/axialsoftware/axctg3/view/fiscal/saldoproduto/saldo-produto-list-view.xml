<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://saldoProdutoListView.title"
      focusComponent="saldoProdutosDataGrid">
    <data>
        <collection id="saldoProdutosDc"
                    class="br.com.axialsoftware.axctg3.entity.fiscal.SaldoProduto">
            <fetchPlan extends="_base">
                <property name="produto" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="saldoProdutosDl" readOnly="true">
                <query>
                    <![CDATA[select e from SaldoProduto e
                    where e.produto.codEmpresa = :codEmpresa
                    order by e.produto.codigo, e.data desc]]>
                </query>
            </loader>
        </collection>
        <instance id="saldoProdutoDc"
                  class="br.com.axialsoftware.axctg3.entity.fiscal.SaldoProduto">
            <fetchPlan extends="_base">
                <property name="produto" fetchPlan="_instance_name"/>
            </fetchPlan>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="saldoProdutosDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="saldoProdutosDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="saldoProdutosDataGrid.removeAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="saldoProdutosDl"/>
            </endSlot>
        </hbox>
        <sidePanelLayout id="sidePanelLayout"
                         width="100%"
                         height="100%"
                         sidePanelHorizontalSize="25em">
            <dataGrid id="saldoProdutosDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="saldoProdutosDc"
                      columnReorderingAllowed="true" themeNames="small">
                <actions>
                    <action id="createAction" type="list_create"/>
                    <action id="editAction" type="list_edit"/>
                    <action id="removeAction" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="codigoProduto" width="12%"/>
                    <column property="descricaoProduto" width="38%"/>
                    <column property="data" width="15%"/>
                    <column property="saldo" width="12%" textAlign="END"/>
                    <column property="valorUnitario" width="12%" textAlign="END"/>
                    <column property="valorTotal" width="11%" textAlign="END"/>
                </columns>
            </dataGrid>
            <vbox>
                <hbox width="100%" justifyContent="BETWEEN" alignItems="CENTER">
                    <h4 id="header" text="msg://saldoProdutoListView.sidePanel.title"/>
                    <button id="closeButton" icon="lumo:cross" themeNames="tertiary icon contrast"/>
                </hbox>
                <vbox>
                    <entityPicker id="produtoField"
                                  property="produto"
                                  dataContainer="saldoProdutoDc"
                                  width="100%" themeNames="small"
                                  label="msg://br.com.axialsoftware.axctg3.entity.fiscal/SaldoProduto.produto">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                    <datePicker id="dataField"
                                property="data"
                                dataContainer="saldoProdutoDc"
                                width="50%" themeNames="small"
                                label="msg://br.com.axialsoftware.axctg3.entity.fiscal/SaldoProduto.data"/>
                    <bigDecimalField id="saldoField"
                                     property="saldo"
                                     dataContainer="saldoProdutoDc"
                                     width="50%" themeNames="small"
                                     label="msg://br.com.axialsoftware.axctg3.entity.fiscal/SaldoProduto.saldo"/>
                    <bigDecimalField id="valorUnitarioField"
                                     property="valorUnitario"
                                     dataContainer="saldoProdutoDc"
                                     width="50%" themeNames="small"
                                     label="msg://br.com.axialsoftware.axctg3.entity.fiscal/SaldoProduto.valorUnitario"/>
                    <bigDecimalField id="valorField"
                                     property="valor"
                                     dataContainer="saldoProdutoDc"
                                     width="50%" themeNames="small"
                                     label="msg://br.com.axialsoftware.axctg3.entity.fiscal/SaldoProduto.valor"/>
                    <hbox id="detailActions">
                        <button id="saveAndCloseBtn" text="msg://br.com.axialsoftware.axctg3/actions.ok" themeNames="primary, small" icon="CHECK"/>
                        <button id="closeBtn" text="msg://br.com.axialsoftware.axctg3/actions.cancelar" themeNames="small" icon="CANCEL"/>
                    </hbox>
                </vbox>
            </vbox>
        </sidePanelLayout>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
