<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://mensagemListView.title"
      focusComponent="mensagensDataGrid">
    <data>
        <collection id="mensagensDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.Mensagem">
            <fetchPlan extends="_base"/>
            <loader id="mensagensDl" readOnly="true">
                <query>
                    <![CDATA[select e from Mensagem e
                    where e.codEmpresa = :codEmpresa
                    order by e.codigo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="mensagensDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="mensagensDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="mensagensDataGrid.removeAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="mensagensDl"/>
            </endSlot>
        </hbox>
        <sidePanelLayout id="sidePanelLayout"
                         width="100%"
                         height="100%"
                         sidePanelHorizontalSize="25em">
            <dataGrid id="mensagensDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="mensagensDc"
                      columnReorderingAllowed="true" themeNames="small">
                <actions>
                    <action id="createAction" type="list_create"/>
                    <action id="editAction" type="list_edit"/>
                    <action id="removeAction" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="codigo" width="15%"/>
                    <column property="texto" width="85%"/>
                </columns>
            </dataGrid>
            <vbox>
                <hbox width="100%" justifyContent="BETWEEN" alignItems="CENTER">
                    <h4 id="header" text="msg://mensagemListView.sidePanel.title"/>
                    <button id="closeButton" icon="lumo:cross" themeNames="tertiary icon contrast"/>
                </hbox>
                <vbox>
                    <integerField id="codigoField" width="30%"
                                  label="msg://br.com.axialsoftware.axctg3.entity.cadastros/Mensagem.codigo"/>
                    <textArea id="textoField" width="100%" minHeight="12em"
                              label="msg://br.com.axialsoftware.axctg3.entity.cadastros/Mensagem.texto"/>
                    <hbox id="detailActions">
                        <button id="saveAndCloseBtn" text="msg://br.com.axialsoftware.axctg3/actions.ok" themeNames="primary, small" icon="CHECK"/>
                        <button id="closeBtn" text="msg://br.com.axialsoftware.axctg3/actions.cancelar" themeNames="small" icon="CANCEL"/>
                    </hbox>
                </vbox>
            </vbox>
        </sidePanelLayout>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
