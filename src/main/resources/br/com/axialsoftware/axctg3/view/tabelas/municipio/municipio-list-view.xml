<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://municipioListView.title"
      focusComponent="municipiosDataGrid">
    <data>
        <collection id="municipiosDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.Municipio">
            <fetchPlan extends="_base"/>
            <loader id="municipiosDl" readOnly="true">
                <query>
                    <![CDATA[select e from Municipio e
                        order by e.codigo asc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="municipiosDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="municipiosDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="municipiosDataGrid.removeAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="municipiosDl"/>
            </endSlot>
        </hbox>
        <sidePanelLayout id="sidePanelLayout" height="100%" width="100%" sidePanelHorizontalSize="100%">
            <dataGrid id="municipiosDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="municipiosDc"
                      columnReorderingAllowed="true"
                      themeNames="small">
                <actions>
                    <action id="createAction" type="list_create"/>
                    <action id="editAction" type="list_edit"/>
                    <action id="removeAction" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="codigo" width="10%" filterable="true"/>
                    <column property="nome" width="80%" filterable="true"/>
                    <column property="uf" width="10%" filterable="true"/>
                </columns>
            </dataGrid>
            <vbox>
                <hbox width="100%" justifyContent="BETWEEN" alignItems="CENTER">
                    <h4 id="header" text="msg://municipioListView.sidePanel.title"/>
                    <button id="closeButton" icon="lumo:cross" themeNames="tertiary icon contrast"/>
                </hbox>
                <vbox>
                    <integerField id="codigoField" width="50%" required="true"
                                  label="msg://br.com.axialsoftware.axctg3.entity.tabelas/Municipio.codigo"/>
                    <textArea id="nomeField" width="100%" minRows="2" maxRows="5"
                               label="msg://br.com.axialsoftware.axctg3.entity.tabelas/Municipio.nome"/>
                    <textField id="ufField" width="50%"
                               label="msg://br.com.axialsoftware.axctg3.entity.tabelas/Municipio.uf"/>
                    <hbox id="detailActions">
                        <button id="saveAndCloseBtn" text="msg://br.com.axialsoftware.axctg3/actions.ok" themeNames="primary, small" icon="CHECK"/>
                        <button id="closeBtn" text="msg://br.com.axialsoftware.axctg3/actions.cancelar" themeNames="small" icon="CANCEL"/>
                    </hbox>
                </vbox>
            </vbox>
        </sidePanelLayout>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
