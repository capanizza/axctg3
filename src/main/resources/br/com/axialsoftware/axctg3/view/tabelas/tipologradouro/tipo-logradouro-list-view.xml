<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://tipoLogradouroListView.title"
      focusComponent="tipoLogradouroesDataGrid">
    <data>
        <collection id="tipoLogradouroesDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.TipoLogradouro">
            <fetchPlan extends="_base"/>
            <loader id="tipoLogradouroesDl" readOnly="true">
                <query>
                    <![CDATA[select e from TipoLogradouro e
                    order by e.codigo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="tipoLogradouroesDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="tipoLogradouroesDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="tipoLogradouroesDataGrid.removeAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="tipoLogradouroesDl"/>
            </endSlot>
        </hbox>
        <sidePanelLayout id="sidePanelLayout"
                         width="100%"
                         height="100%"
                         sidePanelHorizontalSize="25em">

            <!-- MASTER: grid -->
            <dataGrid id="tipoLogradouroesDataGrid"
                      themeNames="small"
                      width="100%"
                      minHeight="20em"
                      dataContainer="tipoLogradouroesDc"
                      columnReorderingAllowed="true">
                <actions>
                    <action id="createAction" type="list_create"/>
                    <action id="editAction" type="list_edit"/>
                    <action id="removeAction" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="codigo" width="20%"/>
                    <column property="descricao" width="80%"/>
                </columns>
            </dataGrid>

            <!-- DETAIL -->
            <vbox>
                <hbox width="100%" justifyContent="BETWEEN" alignItems="CENTER">
                    <h4 id="header" text="msg://tipoLogradouroListView.sidePanel.title"/>
                    <button id="closeButton" icon="lumo:cross" themeNames="tertiary icon contrast"/>
                </hbox>
                <vbox>
                    <textField id="codigoField" width="50%"
                               label="msg://br.com.axialsoftware.axctg3.entity.tabelas/TipoLogradouro.codigo"/>
                    <textField id="descricaoField" width="100%"
                               label="msg://br.com.axialsoftware.axctg3.entity.tabelas/TipoLogradouro.descricao"/>
                    <hbox id="detailActions">
                        <button id="saveAndCloseBtn" text="msg://br.com.axialsoftware.axctg3/actions.ok" themeNames="primary, small" icon="CHECK"/>
                        <button id="closeBtn" text="msg://br.com.axialsoftware.axctg3/actions.cancelar" themeNames="small" icon="CANCEL"/>
                    </hbox>
                </vbox>
            </vbox>
        </sidePanelLayout>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
