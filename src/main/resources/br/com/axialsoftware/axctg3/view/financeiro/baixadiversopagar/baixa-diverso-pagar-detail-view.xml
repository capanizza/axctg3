<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://baixaDiversoPagarDetailView.title"
      focusComponent="form">
    <data>
        <instance id="diversoPagarDc"
                  class="br.com.axialsoftware.axctg3.entity.financeiro.DiversoPagar">
            <fetchPlan extends="_base">
                <property name="parceiro" fetchPlan="_instance_name"/>
                <property name="itens" fetchPlan="_base">
                    <property name="banco" fetchPlan="_instance_name"/>
                    <property name="historicoFinanceiro" fetchPlan="_instance_name"/>
                </property>
                <property name="aberto"/>
                <property name="contabilizadoEmissao"/>
                <property name="contabilizadoBaixa"/>
            </fetchPlan>
            <loader id="diversoPagarDl"/>
            <collection id="itensDc" property="itens"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" width="100%">
            <hbox width="60%">
                <textField id="numeroField"
                           property="numero"
                           dataContainer="diversoPagarDc"
                           width="25%" themeNames="small" readOnly="true"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/DiversoPagar.numero"/>
                <textField id="documentoField"
                           property="documento"
                           dataContainer="diversoPagarDc"
                           width="25%" themeNames="small" readOnly="true"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/DiversoPagar.documento"/>
                <datePicker id="dataEmissaoField"
                            property="dataEmissao"
                            dataContainer="diversoPagarDc"
                            width="25%" themeNames="small" readOnly="true"
                            label="msg://br.com.axialsoftware.axctg3.entity.financeiro/DiversoPagar.dataEmissao"/>
                <datePicker id="dataVencimentoField"
                            property="dataVencimento"
                            dataContainer="diversoPagarDc"
                            width="25%" themeNames="small" readOnly="true"
                            label="msg://br.com.axialsoftware.axctg3.entity.financeiro/DiversoPagar.dataVencimento"/>
            </hbox>
            <hbox width="60%">
                <entityPicker id="parceiroField"
                              property="parceiro"
                              dataContainer="diversoPagarDc"
                              width="75%" themeNames="small" readOnly="true"
                              label="msg://br.com.axialsoftware.axctg3.entity.financeiro/DiversoPagar.parceiro">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
                <textField id="valorField"
                           property="valor"
                           dataContainer="diversoPagarDc"
                           width="25%" themeNames="small" readOnly="true"
                           label="msg://br.com.axialsoftware.axctg3.entity.financeiro/DiversoPagar.valor"/>
            </hbox>
        </vbox>
        <h4 text="msg://br.com.axialsoftware.axctg3.entity.financeiro/DiversoPagar.itens"/>
        <hbox id="itensButtonsPanel" classNames="buttons-panel">
            <button id="itensCreateButton" action="itensDataGrid.createAction" themeNames="small"/>
            <button id="itensEditButton" action="itensDataGrid.editAction" themeNames="small"/>
            <button id="itensRemoveButton" action="itensDataGrid.removeAction" themeNames="small"/>
        </hbox>
        <dataGrid id="itensDataGrid" dataContainer="itensDc" width="100%" minHeight="10em" themeNames="small">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns>
                <column property="item" flexGrow="0"/>
                <column property="historicoFinanceiro" flexGrow="5"/>
                <column property="banco" flexGrow="3"/>
                <column property="data" flexGrow="0"/>
                <column property="valor" textAlign="END" flexGrow="0"/>
                <column property="juros" textAlign="END" flexGrow="0"/>
                <column property="desconto" textAlign="END" flexGrow="0"/>
                <column property="contabilizado" textAlign="CENTER" flexGrow="0"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
