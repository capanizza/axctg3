<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://aliquotaIbsCbsListView.title"
      focusComponent="aliquotaIbsCbsesDataGrid">
    <data>
        <collection id="aliquotaIbsCbsesDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.AliquotaIbsCbs">
            <fetchPlan extends="_base"/>
            <loader id="aliquotaIbsCbsesDl" readOnly="true">
                <query>
                    <![CDATA[select e from AliquotaIbsCbs e
                        order by e.ano asc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="aliquotaIbsCbsesDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="aliquotaIbsCbsesDataGrid.editAction" themeNames="small"/>
                <button id="removeButton" action="aliquotaIbsCbsesDataGrid.removeAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="aliquotaIbsCbsesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="aliquotaIbsCbsesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="aliquotaIbsCbsesDc"
                  columnReorderingAllowed="true"
                  themeNames="small">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="ano" width="20%" filterable="true"/>
                <column property="aliqIbsUf" width="20%"/>
                <column property="aliqIbsMun" width="20%"/>
                <column property="aliqCbs" width="20%"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
