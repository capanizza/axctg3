<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://grupoDetailView.title"
      focusComponent="form">
    <data>
        <instance id="grupoDc"
                  class="br.com.axialsoftware.axctg3.entity.cadastros.Grupo">
            <fetchPlan extends="_base"/>
            <loader id="grupoDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" width="100%">
            <hbox width="100%">
                <!-- código não muda depois de criado: usuários e empresas guardam o número -->
                <integerField id="codigoField"
                              property="codigo"
                              dataContainer="grupoDc"
                              readOnly="true"
                              width="15%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.cadastros/Grupo.codigo"/>
                <textField id="nomeField"
                           property="nome"
                           dataContainer="grupoDc"
                           width="50%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.cadastros/Grupo.nome"/>
            </hbox>
            <!-- só no cadastro de um grupo novo: a primeira empresa e o administrador do
                 grupo são criados no mesmo save (GrupoService.criarGrupo) -->
            <vbox id="novoGrupoBox" width="100%" padding="false" visible="false">
                <h4 text="msg://grupoDetailView.primeiraEmpresa"/>
                <hbox width="100%">
                    <textField id="empresaApelidoField"
                               maxLength="20"
                               width="15%" themeNames="small"
                               label="msg://br.com.axialsoftware.axctg3.entity.cadastros/Empresa.apelido"/>
                    <textField id="empresaNomeField"
                               maxLength="50"
                               width="50%" themeNames="small"
                               label="msg://br.com.axialsoftware.axctg3.entity.cadastros/Empresa.nome"/>
                    <textField id="empresaCnpjField"
                               maxLength="14"
                               width="20%" themeNames="small"
                               label="msg://br.com.axialsoftware.axctg3.entity.cadastros/Empresa.cnpj"/>
                </hbox>
                <h4 text="msg://grupoDetailView.administrador"/>
                <hbox width="100%">
                    <textField id="adminUsernameField"
                               width="25%" themeNames="small"
                               label="msg://br.com.axialsoftware.axctg3.entity/User.username"/>
                    <passwordField id="adminSenhaField"
                                   width="20%" themeNames="small"
                                   label="msg://br.com.axialsoftware.axctg3.entity/User.password"/>
                    <passwordField id="adminConfirmarSenhaField"
                                   width="20%" themeNames="small"
                                   label="msg://grupoDetailView.confirmarSenha"/>
                </hbox>
            </vbox>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
