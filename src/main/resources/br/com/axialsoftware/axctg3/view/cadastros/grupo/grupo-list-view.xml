<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://grupoListView.title"
      focusComponent="gruposDataGrid">
    <data>
        <collection id="gruposDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.Grupo">
            <fetchPlan extends="_base"/>
            <loader id="gruposDl" readOnly="true">
                <query>
                    <![CDATA[select e from Grupo e order by e.codigo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" wrap="true" width="100%">
            <startSlot>
                <button id="createButton" action="gruposDataGrid.createAction" themeNames="small"/>
                <button id="editButton" action="gruposDataGrid.editAction" themeNames="small"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="gruposDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="gruposDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="gruposDc"
                  columnReorderingAllowed="true" themeNames="small">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
            </actions>
            <columns resizable="true">
                <column property="codigo" width="15%" filterable="true"/>
                <column property="nome" width="85%" filterable="true"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" themeNames="small"/>
            <button id="discardButton" action="discardAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
