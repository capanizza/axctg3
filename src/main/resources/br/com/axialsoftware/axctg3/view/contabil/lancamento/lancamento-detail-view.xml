<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://lancamentoDetailView.title"
      focusComponent="form">
    <data>
        <instance id="lancamentoDc"
                  class="br.com.axialsoftware.axctg3.entity.contabil.Lancamento">
            <fetchPlan extends="_base">
                <property name="contaDevedora" fetchPlan="_base"/>
                <property name="contaCredora" fetchPlan="_base"/>
                <property name="centroCusto" fetchPlan="_base"/>
                <property name="historicoContabil" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="lancamentoDl"/>
        </instance>
        <!-- itemsContainer dos entityComboBox abaixo (troca de entityPicker, ver
             memória do projeto entitypicker-not-entitycombobox); codEmpresa/ano da
             sessão via PreLoadEvent, mesmo critério de ContaContabilListView quando
             aberta como lookup (apenasAnaliticas=true). -->
        <collection id="contasContabeisDc"
                    class="br.com.axialsoftware.axctg3.entity.contabil.ContaContabil">
            <loader id="contasContabeisDl">
                <query><![CDATA[select e from ContaContabil e
                    where e.codEmpresa = :codEmpresa and e.ano = :ano and e.analitica = true
                    order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="centrosCustoDc"
                    class="br.com.axialsoftware.axctg3.entity.cadastros.CentroCusto">
            <loader id="centrosCustoDl">
                <query><![CDATA[select e from CentroCusto e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="historicosContabeisDc"
                    class="br.com.axialsoftware.axctg3.entity.contabil.HistoricoContabil">
            <loader id="historicosContabeisDl">
                <query><![CDATA[select e from HistoricoContabil e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" width="100%">
            <!-- numeroField/anoField/mesField/dataLancamentoField: sem property= de
                 propósito — são @NotNull na entidade mas carimbados pelo
                 LancamentoEventListener no save, não digitados. Vinculados via
                 property=, o Bean Validation por-componente do Jmix bloquearia o botão
                 salvar com eles em branco antes do listener rodar. LancamentoDetailView
                 sincroniza o valor exibido manualmente (onBeforeShow). Ver
                 LancamentoDetailViewSalvarTest. codEmpresa não aparece na tela — é a
                 empresa selecionada na sessão, não faz sentido mostrar/editar aqui. -->
            <hbox width="100%">
                <integerField id="numeroField"
                              readOnly="true"
                              width="8%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.numero"/>
                <integerField id="anoField"
                              readOnly="true"
                              width="8%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.ano"/>
                <integerField id="mesField"
                              readOnly="true"
                              width="8%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.mes"/>
                <datePicker id="dataLancamentoField"
                            readOnly="true"
                            width="18%" themeNames="small"
                            label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.dataLancamento"/>
                <integerField id="diaField"
                              property="dia"
                              dataContainer="lancamentoDc"
                              width="8%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.dia"/>
                <bigDecimalField id="valorField"
                                 property="valor"
                                 dataContainer="lancamentoDc"
                                 width="20%" themeNames="small"
                                 label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.valor"/>
            </hbox>
            <hbox width="100%">
                <entityComboBox id="contaDevedoraField"
                                property="contaDevedora"
                                itemsContainer="contasContabeisDc"
                                dataContainer="lancamentoDc"
                                width="45%" themeNames="small"
                                label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.contaDevedora">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityComboBox>
                <entityComboBox id="contaCredoraField"
                                property="contaCredora"
                                itemsContainer="contasContabeisDc"
                                dataContainer="lancamentoDc"
                                width="45%" themeNames="small"
                                label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.contaCredora">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityComboBox>
            </hbox>
            <hbox width="100%">
                <entityComboBox id="centroCustoField"
                                property="centroCusto"
                                itemsContainer="centrosCustoDc"
                                dataContainer="lancamentoDc"
                                width="30%" themeNames="small"
                                label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.centroCusto">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityComboBox>
                <entityComboBox id="historicoContabilField"
                                property="historicoContabil"
                                itemsContainer="historicosContabeisDc"
                                dataContainer="lancamentoDc"
                                width="30%" themeNames="small"
                                label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.historicoContabil">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityComboBox>
                <textField id="origemField"
                           property="origem"
                           dataContainer="lancamentoDc"
                           width="15%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.origem"/>
            </hbox>
            <hbox width="100%">
                <textArea id="complementoHistoricoField"
                          property="complementoHistorico"
                          dataContainer="lancamentoDc"
                          height="9.5em" width="100%" themeNames="small"
                          label="msg://br.com.axialsoftware.axctg3.entity.contabil/Lancamento.complementoHistorico"/>
            </hbox>
        </vbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
