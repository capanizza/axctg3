<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://lancamentoDetailView.title"
      focusComponent="form">
    <data>
        <instance id="lancamentoDc"
                  class="br.com.axialsoftware.axctg3.entity.contabil.Lancamento">
            <fetchPlan extends="_base">
                <property name="contaDevedora" fetchPlan="_base"/>
                <property name="contaCredora" fetchPlan="_base"/>
                <property name="centroCusto" fetchPlan="_base"/>
                <property name="historicoContabil" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="lancamentoDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="lancamentoDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="numeroField" property="numero"/>
            <textField id="anoField" property="ano"/>
            <textField id="mesField" property="mes"/>
            <textField id="diaField" property="dia"/>
            <textField id="codEmpresaField" property="codEmpresa"/>
            <datePicker id="dataLancamentoField" property="dataLancamento"/>
            <entityPicker id="contaDevedoraField" property="contaDevedora">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="contaCredoraField" property="contaCredora">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="centroCustoField" property="centroCusto">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="historicoContabilField" property="historicoContabil">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textArea id="complementoHistoricoField" height="9.5em" property="complementoHistorico"/>
            <textField id="origemField" property="origem"/>
            <textField id="valorField" property="valor"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
