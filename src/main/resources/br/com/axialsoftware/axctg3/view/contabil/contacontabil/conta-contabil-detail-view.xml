<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://contaContabilDetailView.title"
      focusComponent="form">
    <data>
        <instance id="contaContabilDc"
                  class="br.com.axialsoftware.axctg3.entity.contabil.ContaContabil">
            <fetchPlan extends="_base">
                <property name="saldosConta" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="contaContabilDl"/>
            <collection id="saldosContaDc" property="saldosConta"/>
        </instance>
        <!-- containers derivados apenas em memória -->
        <collection id="saldos1Dc"
                    class="br.com.axialsoftware.axctg3.entity.contabil.SaldoConta"/>
        <collection id="saldos2Dc"
                    class="br.com.axialsoftware.axctg3.entity.contabil.SaldoConta"/>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <vbox id="form" classNames="border rounded-m">
            <hbox expand="nomeField" width="100%" alignItems="BASELINE" classNames="border">
                <textField id="codigoField"
                           property="codigo"
                           dataContainer="contaContabilDc" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.codigo"/>
                <textField id="nomeField"
                           property="nome"
                           dataContainer="contaContabilDc" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.nome"/>
                <integerField id="grauField"
                              property="grau"
                              dataContainer="contaContabilDc"
                              width="15%" themeNames="small"
                              label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.grau"/>
                <checkbox id="analiticaField"
                          property="analitica"
                          dataContainer="contaContabilDc" alignSelf="BASELINE"
                          label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.analitica"/>
            </hbox>
            <hbox expand="codNatField" width="100%" alignItems="START" classNames="border">
                <select id="codNatField"
                        property="codNat"
                        dataContainer="contaContabilDc" themeNames="small"
                        label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.codNat"/>
                <textField id="codContaEncField"
                           property="codContaEnc"
                           dataContainer="contaContabilDc"
                           width="15%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.codContaEnc"/>
                <textField id="codContaRefField"
                           property="codContaRef"
                           dataContainer="contaContabilDc"
                           width="15%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.codContaRef"/>
                <textField id="codContaSupField"
                           property="codContaSup"
                           dataContainer="contaContabilDc"
                           width="15%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.codContaSup"/>
                <textField id="saldoTransfField"
                           property="saldoTransf"
                           dataContainer="contaContabilDc"
                           width="15%" themeNames="small"
                           label="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.saldoTransf"/>
            </hbox>
        </vbox>
        <h4 text="msg://br.com.axialsoftware.axctg3.entity.contabil/ContaContabil.saldosConta"/>
        <!--dataGrid id="saldosContaDataGrid"
                  dataContainer="saldosContaDc"
                  width="100%"
                  minHeight="20em" themeNames="small">
            <columns>
                <column property="mes"/>
                <column property="saldoAnterior"/>
                <column property="debitoMes"/>
                <column property="creditoMes"/>
                <column property="saldoAtual"/>
            </columns>
        </dataGrid-->
        <hbox width="100%" spacing="true">
            <dataGrid id="saldos1DataGrid"
                      dataContainer="saldos1Dc"
                      width="50%"
                      minHeight="20em" themeNames="small">
                <columns>
                    <column property="mes" width="8%"/>
                    <column property="saldoAnterior" width="23%" textAlign="END"/>
                    <column property="debitoMes" width="23%" textAlign="END"/>
                    <column property="creditoMes" width="23%" textAlign="END"/>
                    <column property="saldoAtual" width="23%" textAlign="END"/>
                </columns>
            </dataGrid>

            <dataGrid id="saldos2DataGrid"
                      dataContainer="saldos2Dc"
                      width="50%"
                      minHeight="20em" themeNames="small">
                <columns>
                    <column property="mes" width="8%"/>
                    <column property="saldoAnterior" width="23%" textAlign="END"/>
                    <column property="debitoMes" width="23%" textAlign="END"/>
                    <column property="creditoMes" width="23%" textAlign="END"/>
                    <column property="saldoAtual" width="23%" textAlign="END"/>
                </columns>
            </dataGrid>
        </hbox>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="small"/>
            <button id="closeButton" action="closeAction" themeNames="small"/>
        </hbox>
    </layout>
</view>
