                <property name="histFinBaixaJurosPagar" fetchPlan="_base"/>
                <property name="histFinBaixaDescontoPagar" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="empresaDl"/>
        </instance>
        <!-- Fontes de itens dos entityComboBox abaixo (troca de entityPicker, ver
             memória do projeto entitypicker-not-entitycombobox). Tabelas globais
             (TipoLogradouro/Municipio) sem filtro; as demais filtram por codEmpresa
             da sessão (mesmo critério que ContaContabilListView/ProdutoListView/etc já
             usam), setado via PreLoadEvent em EmpresaDetailView. Um container por
             entidade, compartilhado entre todos os campos que apontam pra ela. -->
        <collection id="tiposLogradouroDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.TipoLogradouro">
            <loader id="tiposLogradouroDl">
                <query><![CDATA[select e from TipoLogradouro e order by e.descricao]]></query>
            </loader>
        </collection>
        <collection id="municipiosDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.Municipio">
            <loader id="municipiosDl">
                <query><![CDATA[select e from Municipio e order by e.nome]]></query>
            </loader>
        </collection>
        <collection id="contasContabeisDc"
                    class="br.com.axialsoftware.axctg3.entity.contabil.ContaContabil">
            <loader id="contasContabeisDl">
                <query><![CDATA[select e from ContaContabil e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="produtosEmpresaDc"
                    class="br.com.axialsoftware.axctg3.entity.fiscal.Produto">
            <loader id="produtosEmpresaDl">
                <query><![CDATA[select e from Produto e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="historicosContabeisDc"
                    class="br.com.axialsoftware.axctg3.entity.contabil.HistoricoContabil">
            <loader id="historicosContabeisDl">
                <query><![CDATA[select e from HistoricoContabil e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
        <collection id="historicosFinanceirosDc"
                    class="br.com.axialsoftware.axctg3.entity.financeiro.HistoricoFinanceiro">
            <loader id="historicosFinanceirosDl">
                <query><![CDATA[select e from HistoricoFinanceiro e where e.codEmpresa = :codEmpresa order by e.codigo]]></query>
            </loader>
        </collection>
    </data>
