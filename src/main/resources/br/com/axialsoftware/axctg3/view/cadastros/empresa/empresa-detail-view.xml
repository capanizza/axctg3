<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://empresaDetailView.title"
      focusComponent="form">
    <data>
        <instance id="empresaDc"
                  class="br.com.axialsoftware.axctg3.entity.cadastros.Empresa">
            <fetchPlan extends="_base">
                <property name="tipoLogradouro" fetchPlan="_base"/>
                <property name="municipio" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="empresaDl"/>
        </instance>
        <collection id="tipoLogradourosDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.TipoLogradouro"
                    fetchPlan="_base">
            <loader id="tipoLogradourosDl">
                <query>
                    <![CDATA[select e from TipoLogradouro e
                    order by e.codigo]]>
                </query>
            </loader>
        </collection>
        <collection id="municipiosDc"
                    class="br.com.axialsoftware.axctg3.entity.tabelas.Municipio"
                    fetchPlan="_base">
            <loader id="municipiosDl">
                <query>
                    <![CDATA[select e from Municipio e
                    order by e.codigo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
