<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/17-091725-c1f40fd1-natureza_operacao-produto-classtrib-fk-vincular.xml">
    <!--
        NATUREZA_OPERACAO.COD_CLASS_TRIB e PRODUTO.COD_CLASS_TRIB (Integer solto, sem FK)
        viram referência real pra CLASS_TRIB — mesmo padrão de
        ContaContabil.contaReferencial (ver
        2026/08/14-155546-c1f40fd1-contacontabil-contareferencial-vincular.xml). Sem
        migração de dado por SQL: conferido no Postgres de dev que NATUREZA_OPERACAO tem
        412 linhas e nenhuma com COD_CLASS_TRIB preenchido, e PRODUTO tem 0 linhas — não
        há valor pra perder. Um ambiente que já tenha COD_CLASS_TRIB populado precisa
        migrar esse valor pra CLASS_TRIB_ID (lookup por CODIGO) antes de rodar este
        changeset, porque o dropColumn descarta o dado sem aviso.

        Não edita o changeset que criou COD_CLASS_TRIB em PRODUTO/ITEM_NOTA_SAIDA
        (2026/08/17-085140-...) porque já foi aplicado — ver convenção de changelog em
        CLAUDE.md.
    -->
    <changeSet id="1" author="axctg3">
        <dropColumn tableName="NATUREZA_OPERACAO" columnName="COD_CLASS_TRIB"/>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <addColumn tableName="NATUREZA_OPERACAO">
            <column name="CLASS_TRIB_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_NATUREZA_OPERACAO_CLASS_TRIB" tableName="NATUREZA_OPERACAO">
            <column name="CLASS_TRIB_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CLASS_TRIB_ID" baseTableName="NATUREZA_OPERACAO"
                                  constraintName="FK_NATUREZA_OPERACAO_ON_CLASS_TRIB" referencedColumnNames="ID"
                                  referencedTableName="CLASS_TRIB"/>
    </changeSet>
    <changeSet id="4" author="axctg3">
        <dropColumn tableName="PRODUTO" columnName="COD_CLASS_TRIB"/>
    </changeSet>
    <changeSet id="5" author="axctg3">
        <addColumn tableName="PRODUTO">
            <column name="CLASS_TRIB_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet id="6" author="axctg3">
        <createIndex indexName="IDX_PRODUTO_CLASS_TRIB" tableName="PRODUTO">
            <column name="CLASS_TRIB_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CLASS_TRIB_ID" baseTableName="PRODUTO"
                                  constraintName="FK_PRODUTO_ON_CLASS_TRIB" referencedColumnNames="ID"
                                  referencedTableName="CLASS_TRIB"/>
    </changeSet>
</databaseChangeLog>
