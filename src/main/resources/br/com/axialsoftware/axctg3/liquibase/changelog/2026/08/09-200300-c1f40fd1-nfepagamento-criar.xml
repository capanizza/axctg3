<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/09-200300-c1f40fd1-nfepagamento-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="NFE_PAGAMENTO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NFE_PAGAMENTO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="NFE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="IND_PAG" type="INT"/>
            <column name="TIPO_PAG" type="VARCHAR(2)"/>
            <column name="DESCRICAO_PAG" type="VARCHAR(60)"/>
            <column name="VALOR_PAG" type="DECIMAL(19, 2)"/>
            <column name="TIPO_INTEGRACAO_CARTAO" type="INT"/>
            <column name="CNPJ_CREDENCIADORA" type="VARCHAR(14)"/>
            <column name="BANDEIRA_CARTAO" type="VARCHAR(2)"/>
            <column name="NUMERO_AUTORIZACAO_CARTAO" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_NFE_PAGAMENTO_NFE" tableName="NFE_PAGAMENTO">
            <column name="NFE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="NFE_ID" baseTableName="NFE_PAGAMENTO"
                                 constraintName="FK_NFE_PAGAMENTO_ON_NFE" referencedColumnNames="ID"
                                 referencedTableName="NFE"/>
    </changeSet>
</databaseChangeLog>
