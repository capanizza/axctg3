<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/10/20-093711-c1f40fd1-imp_historico_financeiro-criar.xml">
    <!-- Históricos financeiros do legado (HISTFIN) num lote de importação, gravados pelo
         exportador do projeto Axial; a tela ImpLote.list confere e importa. -->
    <changeSet id="1" author="axctg3">
        <createTable tableName="IMP_HISTORICO_FINANCEIRO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_HISTORICO_FINANCEIRO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LOTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CODIGO" type="INT"/>
            <column name="NOME" type="VARCHAR(255)"/>
            <column name="EMISSAO" type="VARCHAR(255)"/>
            <column name="BAIXA" type="VARCHAR(255)"/>
            <column name="PARCIAL" type="VARCHAR(255)"/>
            <column name="JUROS" type="VARCHAR(255)"/>
            <column name="DESCONTO" type="VARCHAR(255)"/>
            <column name="COD_CONTABIL_ENT" type="VARCHAR(255)"/>
            <column name="HIST_ENT" type="INT"/>
            <column name="COD_CONTABIL_SAI" type="VARCHAR(255)"/>
            <column name="HIST_SAI" type="INT"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="IMP_HISTORICO_FINANCEIRO" baseColumnNames="LOTE_ID"
                                 constraintName="FK_IMP_HISTORICO_FINANCEIRO_ON_LOTE"
                                 referencedTableName="IMP_LOTE" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_IMP_HISTORICO_FINANCEIRO_LOTE" tableName="IMP_HISTORICO_FINANCEIRO">
            <column name="LOTE_ID"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
