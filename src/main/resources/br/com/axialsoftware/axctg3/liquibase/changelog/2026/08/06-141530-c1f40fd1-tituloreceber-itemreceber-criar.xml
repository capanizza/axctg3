<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/06-141530-c1f40fd1-tituloreceber-itemreceber-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="TITULO_RECEBER">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TITULO_RECEBER"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="NOTA_SAIDA_ID" type="UUID"/>
            <column name="NUMERO" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="COD_EMPRESA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_EMISSAO" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_VENCIMENTO" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="PARCEIRO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="BANCO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="NUM_BANCO" type="VARCHAR(255)"/>
            <column name="VALOR" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="OBSERVACAO" type="CLOB"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_TITULO_RECEBER_NOTA_SAIDA" tableName="TITULO_RECEBER">
            <column name="NOTA_SAIDA_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="NOTA_SAIDA_ID" baseTableName="TITULO_RECEBER"
                                 constraintName="FK_TITULO_RECEBER_ON_NOTA_SAIDA" referencedColumnNames="ID"
                                 referencedTableName="NOTA_SAIDA"/>
    </changeSet>

    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_TITULO_RECEBER_PARCEIRO" tableName="TITULO_RECEBER">
            <column name="PARCEIRO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="PARCEIRO_ID" baseTableName="TITULO_RECEBER"
                                 constraintName="FK_TITULO_RECEBER_ON_PARCEIRO" referencedColumnNames="ID"
                                 referencedTableName="PARCEIRO"/>
    </changeSet>

    <changeSet id="4" author="axctg3">
        <createIndex indexName="IDX_TITULO_RECEBER_BANCO" tableName="TITULO_RECEBER">
            <column name="BANCO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="BANCO_ID" baseTableName="TITULO_RECEBER"
                                 constraintName="FK_TITULO_RECEBER_ON_BANCO" referencedColumnNames="ID"
                                 referencedTableName="BANCO"/>
    </changeSet>

    <changeSet id="5" author="axctg3">
        <createIndex indexName="IDX_TITULO_RECEBER_DATA_EMISSAO" tableName="TITULO_RECEBER">
            <column name="DATA_EMISSAO"/>
        </createIndex>
    </changeSet>

    <changeSet id="6" author="axctg3">
        <createIndex indexName="IDX_TITULO_RECEBER_DATA_VENCIMENTO" tableName="TITULO_RECEBER">
            <column name="DATA_VENCIMENTO"/>
        </createIndex>
    </changeSet>

    <!--
        Índice único NUMERO+COD_EMPRESA. Postgres usa índice parcial (soft delete);
        HSQLDB (testes) não suporta índice parcial, então cobre também as linhas com
        soft delete — mais restritivo nos testes do que em produção. Ver o comentário
        em 05-081142-c1f40fd1-indices-unicos-hsqldb.xml.
    -->
    <changeSet id="7" author="axctg3" dbms="postgresql">
        <createIndex indexName="IDX_TITULO_RECEBER_UNQ_NUMERO_COD_EMPRESA" tableName="TITULO_RECEBER" unique="true">
            <column name="NUMERO"/>
            <column name="COD_EMPRESA"/>
        </createIndex>

        <modifySql>
            <append value="where DELETED_DATE is null"/>
        </modifySql>
    </changeSet>

    <changeSet id="8" author="axctg3" dbms="hsqldb">
        <createIndex indexName="IDX_TITULO_RECEBER_UNQ_NUMERO_COD_EMPRESA" tableName="TITULO_RECEBER" unique="true">
            <column name="NUMERO"/>
            <column name="COD_EMPRESA"/>
        </createIndex>
    </changeSet>

    <changeSet id="9" author="axctg3">
        <createTable tableName="ITEM_RECEBER">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ITEM_RECEBER"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="TITULO_RECEBER_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ITEM" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DATA" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="HISTORICO_FINANCEIRO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="VALOR" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="JUROS" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCONTO" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="CONTABILIZADO" type="BOOLEAN" defaultValue="FALSE"/>
        </createTable>
    </changeSet>

    <changeSet id="10" author="axctg3">
        <createIndex indexName="IDX_ITEM_RECEBER_TITULO_RECEBER" tableName="ITEM_RECEBER">
            <column name="TITULO_RECEBER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="TITULO_RECEBER_ID" baseTableName="ITEM_RECEBER"
                                 constraintName="FK_ITEM_RECEBER_ON_TITULO_RECEBER" referencedColumnNames="ID"
                                 referencedTableName="TITULO_RECEBER"/>
    </changeSet>

    <changeSet id="11" author="axctg3">
        <createIndex indexName="IDX_ITEM_RECEBER_HISTORICO_FINANCEIRO" tableName="ITEM_RECEBER">
            <column name="HISTORICO_FINANCEIRO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="HISTORICO_FINANCEIRO_ID" baseTableName="ITEM_RECEBER"
                                 constraintName="FK_ITEM_RECEBER_ON_HISTORICO_FINANCEIRO" referencedColumnNames="ID"
                                 referencedTableName="HISTORICO_FINANCEIRO"/>
    </changeSet>

    <changeSet id="12" author="axctg3">
        <createIndex indexName="IDX_ITEM_RECEBER_DATA" tableName="ITEM_RECEBER">
            <column name="DATA"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
