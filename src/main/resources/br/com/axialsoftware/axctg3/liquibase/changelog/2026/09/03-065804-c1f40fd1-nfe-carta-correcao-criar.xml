<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/09/03-065804-c1f40fd1-nfe-carta-correcao-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="NFE_CARTA_CORRECAO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_NFE_CARTA_CORRECAO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="NFE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="NUMERO_SEQUENCIAL" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="TEXTO_CORRECAO" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_HORA_EVENTO" type="${offsetDateTime.type}"/>
            <column name="CCE_C_STAT" type="INT"/>
            <column name="CCE_X_MOTIVO" type="VARCHAR(255)"/>
            <column name="CCE_N_PROT" type="VARCHAR(15)"/>
            <column name="CCE_DH_REG_EVENTO" type="${offsetDateTime.type}"/>
            <column name="CCE_XML_RETORNO" type="CLOB"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_NFE_CARTA_CORRECAO_NFE" tableName="NFE_CARTA_CORRECAO">
            <column name="NFE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="NFE_ID" baseTableName="NFE_CARTA_CORRECAO"
                                 constraintName="FK_NFE_CARTA_CORRECAO_ON_NFE" referencedColumnNames="ID"
                                 referencedTableName="NFE"/>
    </changeSet>
</databaseChangeLog>
