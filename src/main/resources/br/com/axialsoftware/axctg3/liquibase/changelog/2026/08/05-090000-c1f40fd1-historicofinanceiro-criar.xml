<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/05-090000-c1f40fd1-historicofinanceiro-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="HISTORICO_FINANCEIRO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_HISTORICO_FINANCEIRO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="CODIGO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="COD_EMPRESA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="NOME" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="EMISSAO" type="BOOLEAN"/>
            <column name="BAIXA" type="BOOLEAN"/>
            <column name="PARCIAL" type="BOOLEAN"/>
            <column name="JUROS" type="BOOLEAN"/>
            <column name="DESCONTO" type="BOOLEAN"/>
            <column name="CONTA_CONTABIL_RECEBER_ID" type="UUID"/>
            <column name="HISTORICO_CONTABIL_RECEBER_ID" type="UUID"/>
            <column name="CONTA_CONTABIL_PAGAR_ID" type="UUID"/>
            <column name="HISTORICO_CONTABIL_PAGAR_ID" type="UUID"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_HISTORICO_FINANCEIRO_CONTA_CONTABIL_RECEBER" tableName="HISTORICO_FINANCEIRO">
            <column name="CONTA_CONTABIL_RECEBER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CONTA_CONTABIL_RECEBER_ID" baseTableName="HISTORICO_FINANCEIRO"
                                 constraintName="FK_HISTORICO_FINANCEIRO_ON_CONTA_CONTABIL_RECEBER" referencedColumnNames="ID"
                                 referencedTableName="CONTA_CONTABIL"/>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_HISTORICO_FINANCEIRO_HISTORICO_CONTABIL_RECEBER" tableName="HISTORICO_FINANCEIRO">
            <column name="HISTORICO_CONTABIL_RECEBER_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="HISTORICO_CONTABIL_RECEBER_ID" baseTableName="HISTORICO_FINANCEIRO"
                                 constraintName="FK_HISTORICO_FINANCEIRO_ON_HISTORICO_CONTABIL_RECEBER" referencedColumnNames="ID"
                                 referencedTableName="HISTORICO_CONTABIL"/>
    </changeSet>
    <changeSet id="4" author="axctg3">
        <createIndex indexName="IDX_HISTORICO_FINANCEIRO_CONTA_CONTABIL_PAGAR" tableName="HISTORICO_FINANCEIRO">
            <column name="CONTA_CONTABIL_PAGAR_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CONTA_CONTABIL_PAGAR_ID" baseTableName="HISTORICO_FINANCEIRO"
                                 constraintName="FK_HISTORICO_FINANCEIRO_ON_CONTA_CONTABIL_PAGAR" referencedColumnNames="ID"
                                 referencedTableName="CONTA_CONTABIL"/>
    </changeSet>
    <changeSet id="5" author="axctg3">
        <createIndex indexName="IDX_HISTORICO_FINANCEIRO_HISTORICO_CONTABIL_PAGAR" tableName="HISTORICO_FINANCEIRO">
            <column name="HISTORICO_CONTABIL_PAGAR_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="HISTORICO_CONTABIL_PAGAR_ID" baseTableName="HISTORICO_FINANCEIRO"
                                 constraintName="FK_HISTORICO_FINANCEIRO_ON_HISTORICO_CONTABIL_PAGAR" referencedColumnNames="ID"
                                 referencedTableName="HISTORICO_CONTABIL"/>
    </changeSet>

    <!--
        Índice único CODIGO+COD_EMPRESA. Postgres usa índice parcial (soft delete);
        HSQLDB (testes) não suporta índice parcial, então cobre também as linhas com
        soft delete — mais restritivo nos testes do que em produção. Ver o comentário
        em 05-081142-c1f40fd1-indices-unicos-hsqldb.xml.
    -->
    <changeSet id="6" author="axctg3" dbms="postgresql">
        <createIndex indexName="IDX_HISTORICO_FINANCEIRO_UNQ" tableName="HISTORICO_FINANCEIRO" unique="true">
            <column name="CODIGO"/>
            <column name="COD_EMPRESA"/>
        </createIndex>

        <modifySql>
            <append value="where DELETED_DATE is null"/>
        </modifySql>
    </changeSet>

    <changeSet id="7" author="axctg3" dbms="hsqldb">
        <createIndex indexName="IDX_HISTORICO_FINANCEIRO_UNQ" tableName="HISTORICO_FINANCEIRO" unique="true">
            <column name="CODIGO"/>
            <column name="COD_EMPRESA"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
