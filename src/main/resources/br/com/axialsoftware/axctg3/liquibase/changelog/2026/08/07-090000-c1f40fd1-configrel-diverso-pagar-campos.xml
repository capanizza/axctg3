<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/07-090000-c1f40fd1-configrel-diverso-pagar-campos.xml">
    <changeSet id="1" author="axctg3">
        <addColumn tableName="CONFIG_REL">
            <column name="data_emissao_diverso_inicial" type="DATE"/>
            <column name="data_emissao_diverso_final" type="DATE"/>
            <column name="data_vencimento_diverso_inicial" type="DATE"/>
            <column name="data_vencimento_diverso_final" type="DATE"/>
            <column name="data_emissao_diverso_inicial_listagem" type="DATE"/>
            <column name="data_emissao_diverso_final_listagem" type="DATE"/>
            <column name="data_baixa_diverso_inicial_listagem" type="DATE"/>
            <column name="data_baixa_diverso_final_listagem" type="DATE"/>
            <column name="data_baixa_pagar" type="DATE"/>
            <column name="banco_inicial" type="INT"/>
            <column name="banco_id" type="UUID"/>
        </addColumn>
    </changeSet>

    <changeSet id="2" author="axctg3">
        <addForeignKeyConstraint baseColumnNames="banco_id" baseTableName="CONFIG_REL"
                                 constraintName="FK_CONFIG_REL_ON_BANCO" referencedColumnNames="ID"
                                 referencedTableName="BANCO"/>
    </changeSet>
</databaseChangeLog>
