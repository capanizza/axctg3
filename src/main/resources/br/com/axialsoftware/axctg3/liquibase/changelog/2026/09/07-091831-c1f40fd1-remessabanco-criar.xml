<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/09/07-091831-c1f40fd1-remessabanco-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="REMESSA_BANCO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_REMESSA_BANCO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="COD_EMPRESA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="BANCO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_GERACAO" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="NUM_REMESSA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="QUANTIDADE_TITULOS" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="VALOR_TOTAL" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_REMESSA_BANCO_COD_EMPRESA" tableName="REMESSA_BANCO">
            <column name="COD_EMPRESA"/>
        </createIndex>
        <createIndex indexName="IDX_REMESSA_BANCO_BANCO" tableName="REMESSA_BANCO">
            <column name="BANCO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="BANCO_ID" baseTableName="REMESSA_BANCO"
                                 constraintName="FK_REMESSA_BANCO_ON_BANCO" referencedColumnNames="ID"
                                 referencedTableName="BANCO"/>
    </changeSet>
</databaseChangeLog>
