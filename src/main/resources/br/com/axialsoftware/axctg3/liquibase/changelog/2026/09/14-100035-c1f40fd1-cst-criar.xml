<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/09/14-100035-c1f40fd1-cst-criar.xml">
    <!--
        Catálogo de CST/CSOSN de ICMS (ver Javadoc de entity.tabelas.Cst) — substitui a
        árvore de decisão procedural que o legado calculava na stored procedure
        SituacaoTributaria a partir de flags cruzadas de Natureza/Produto. Seed fixo com
        os 21 códigos oficiais (11 CST regime normal + 10 CSOSN Simples Nacional, Anexo do
        Convênio s/n de 1970 / Ato COTEPE 44/2018) — tabela pequena e estável, sem fonte
        externa que mude com frequência, então sem CSV/import como ClassTrib.
    -->
    <changeSet id="1" author="axctg3">
        <createTable tableName="CST">
            <column name="ID" type="${uuid.type}">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_CST"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="CODIGO" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRICAO" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="CSOSN" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3" dbms="postgresql">
        <!-- Unique parcial (só linhas não soft-deletadas) — mesmo padrão de
             IDX_CLASS_TRIB_UNQ em 2026/08/09-180000-...-classtrib-criar.xml. -->
        <createIndex indexName="IDX_CST_UNQ" tableName="CST" unique="true">
            <column name="CODIGO"/>
        </createIndex>

        <modifySql>
            <append value="where DELETED_DATE is null"/>
        </modifySql>
    </changeSet>
    <changeSet id="3" author="axctg3" dbms="hsqldb">
        <!-- HSQLDB (banco de teste) não suporta o índice único parcial do changeSet
             acima — mesmo índice, sem a cláusula WHERE. -->
        <createIndex indexName="IDX_CST_UNQ" tableName="CST" unique="true">
            <column name="CODIGO"/>
        </createIndex>
    </changeSet>
