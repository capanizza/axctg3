<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/20-160344-c1f40fd1-classificacaofiscal-remover-auditoria.xml">

    <!-- ClassificacaoFiscal deixa de ter version/auditoria/soft delete, a pedido.
         O índice único parcial (where DELETED_DATE is null) depende da coluna
         DELETED_DATE, então precisa ser derrubado antes de dropar as colunas. -->
    <changeSet id="1" author="axctg3" dbms="postgresql">
        <dropIndex indexName="IDX_CLASSIFICACAO_FISCAL_UNQ" tableName="CLASSIFICACAO_FISCAL"/>
    </changeSet>

    <changeSet id="2" author="axctg3">
        <dropColumn tableName="CLASSIFICACAO_FISCAL">
            <column name="VERSION"/>
            <column name="CREATED_BY"/>
            <column name="CREATED_DATE"/>
            <column name="LAST_MODIFIED_BY"/>
            <column name="LAST_MODIFIED_DATE"/>
            <column name="DELETED_BY"/>
            <column name="DELETED_DATE"/>
        </dropColumn>
    </changeSet>

    <!-- Recria o índice único, agora sem o filtro de soft delete (a tabela não tem mais
         DELETED_DATE). No HSQLDB de teste esse índice nunca existiu (o changeset original
         de criação era postgresql-only), então não há equivalente a recriar lá.
         Sem soft delete, um CODIGO removido e recriado (legal sob o índice parcial antigo,
         desde que só uma cópia estivesse "viva") vira duplicata e este CREATE UNIQUE INDEX
         falha. Avaliado e aceito conscientemente: tabela pequena, importada de outro
         sistema, sem esse padrão de uso na prática — não vale a complexidade de uma limpeza
         automática (chegou a existir um changeSet pra isso, removido por ter tentado rodar
         contra uma coluna DELETED_DATE que um deploy anterior já tinha dropado). Se um dia
         aparecer duplicata real, o erro do Postgres aponta a linha pra reconciliar na mão. -->
    <changeSet id="3" author="axctg3" dbms="postgresql">
        <createIndex indexName="IDX_CLASSIFICACAO_FISCAL_UNQ" tableName="CLASSIFICACAO_FISCAL" unique="true">
            <column name="CODIGO"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
