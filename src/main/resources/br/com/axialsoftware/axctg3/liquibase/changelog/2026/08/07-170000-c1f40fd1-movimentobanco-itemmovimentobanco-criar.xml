<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/07-170000-c1f40fd1-movimentobanco-itemmovimentobanco-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="MOVIMENTO_BANCO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_MOVIMENTO_BANCO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LANCAMENTO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="COD_EMPRESA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DATA" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="BANCO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="HISTORICO_FINANCEIRO_ID" type="UUID"/>
            <column name="VALOR" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="DOCUMENTO" type="VARCHAR(20)"/>
            <column name="DESCRICAO" type="VARCHAR(30)"/>
            <column name="CHEQUE" type="INT"/>
            <column name="CONTA_CONTABIL_ID" type="UUID"/>
            <column name="ENTRADA" type="BOOLEAN" defaultValue="FALSE"/>
            <column name="CONTABILIZADO" type="BOOLEAN" defaultValue="FALSE"/>
            <column name="TIPO_SALDO" type="BOOLEAN" defaultValue="FALSE"/>
        </createTable>
    </changeSet>

    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_MOVIMENTO_BANCO_BANCO" tableName="MOVIMENTO_BANCO">
            <column name="BANCO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="BANCO_ID" baseTableName="MOVIMENTO_BANCO"
                                 constraintName="FK_MOVIMENTO_BANCO_ON_BANCO" referencedColumnNames="ID"
                                 referencedTableName="BANCO"/>
    </changeSet>

    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_MOVIMENTO_BANCO_HISTORICO_FINANCEIRO" tableName="MOVIMENTO_BANCO">
            <column name="HISTORICO_FINANCEIRO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="HISTORICO_FINANCEIRO_ID" baseTableName="MOVIMENTO_BANCO"
                                 constraintName="FK_MOVIMENTO_BANCO_ON_HISTORICO_FINANCEIRO" referencedColumnNames="ID"
                                 referencedTableName="HISTORICO_FINANCEIRO"/>
    </changeSet>

    <changeSet id="4" author="axctg3">
        <createIndex indexName="IDX_MOVIMENTO_BANCO_CONTA_CONTABIL" tableName="MOVIMENTO_BANCO">
            <column name="CONTA_CONTABIL_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CONTA_CONTABIL_ID" baseTableName="MOVIMENTO_BANCO"
                                 constraintName="FK_MOVIMENTO_BANCO_ON_CONTA_CONTABIL" referencedColumnNames="ID"
                                 referencedTableName="CONTA_CONTABIL"/>
    </changeSet>

    <changeSet id="5" author="axctg3">
        <createIndex indexName="IDX_MOVIMENTO_BANCO_DATA" tableName="MOVIMENTO_BANCO">
            <column name="DATA"/>
        </createIndex>
    </changeSet>

    <changeSet id="6" author="axctg3" dbms="postgresql">
        <createIndex indexName="IDX_MOVIMENTO_BANCO_UNQ_LANCAMENTO_COD_EMPRESA" tableName="MOVIMENTO_BANCO" unique="true">
            <column name="LANCAMENTO"/>
            <column name="COD_EMPRESA"/>
        </createIndex>

        <modifySql>
            <append value="where DELETED_DATE is null"/>
        </modifySql>
    </changeSet>

    <changeSet id="7" author="axctg3" dbms="hsqldb">
        <createIndex indexName="IDX_MOVIMENTO_BANCO_UNQ_LANCAMENTO_COD_EMPRESA" tableName="MOVIMENTO_BANCO" unique="true">
            <column name="LANCAMENTO"/>
            <column name="COD_EMPRESA"/>
        </createIndex>
    </changeSet>

    <changeSet id="8" author="axctg3">
        <createTable tableName="ITEM_MOVIMENTO_BANCO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ITEM_MOVIMENTO_BANCO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="MOVIMENTO_BANCO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ITEM" type="INT"/>
            <column name="LANCADO" type="BOOLEAN" defaultValue="FALSE"/>
        </createTable>
    </changeSet>

    <changeSet id="9" author="axctg3">
        <createIndex indexName="IDX_ITEM_MOVIMENTO_BANCO_MOVIMENTO_BANCO" tableName="ITEM_MOVIMENTO_BANCO">
            <column name="MOVIMENTO_BANCO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="MOVIMENTO_BANCO_ID" baseTableName="ITEM_MOVIMENTO_BANCO"
                                 constraintName="FK_ITEM_MOVIMENTO_BANCO_ON_MOVIMENTO_BANCO" referencedColumnNames="ID"
                                 referencedTableName="MOVIMENTO_BANCO"/>
    </changeSet>
</databaseChangeLog>
