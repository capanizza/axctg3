<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/10/10-110714-c1f40fd1-imp_lote-criar.xml">
    <!-- Tabelas intermediárias da importação do legado: o exportador do projeto Axial grava
         aqui (códigos do legado, sem UUID de entidade real) e a tela ImpLote.list importa. -->
    <changeSet id="1" author="axctg3">
        <createTable tableName="IMP_LOTE">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_LOTE"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="TIPO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="SITUACAO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="COD_EMPRESA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="COD_EMPRESA_LEGADO" type="INT"/>
            <column name="ANO" type="INT"/>
            <column name="QTD_LINHAS" type="INT"/>
            <column name="DATA_IMPORTACAO" type="${offsetDateTime.type}"/>
            <column name="MENSAGEM" type="CLOB"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createTable tableName="IMP_CONTA_CONTABIL">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_CONTA_CONTABIL"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LOTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CODIGO" type="VARCHAR(25)">
                <constraints nullable="false"/>
            </column>
            <column name="NOME" type="VARCHAR(100)"/>
            <column name="GRAU" type="INT"/>
            <column name="ANALITICA" type="VARCHAR(1)"/>
            <column name="CONTA_ENC" type="VARCHAR(25)"/>
            <column name="CONTA_REFERENCIAL" type="VARCHAR(25)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="IMP_CONTA_CONTABIL" baseColumnNames="LOTE_ID"
                                 constraintName="FK_IMP_CONTA_CONTABIL_ON_LOTE"
                                 referencedTableName="IMP_LOTE" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_IMP_CONTA_CONTABIL_LOTE" tableName="IMP_CONTA_CONTABIL">
            <column name="LOTE_ID"/>
        </createIndex>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createTable tableName="IMP_SALDO_CONTA">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_SALDO_CONTA"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LOTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CONTA" type="VARCHAR(25)">
                <constraints nullable="false"/>
            </column>
            <column name="MES" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="SALDO_ANTERIOR" type="DECIMAL(19, 2)"/>
            <column name="DEBITO_MES" type="DECIMAL(19, 2)"/>
            <column name="CREDITO_MES" type="DECIMAL(19, 2)"/>
            <column name="SALDO_TRANSF" type="DECIMAL(19, 2)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="IMP_SALDO_CONTA" baseColumnNames="LOTE_ID"
                                 constraintName="FK_IMP_SALDO_CONTA_ON_LOTE"
                                 referencedTableName="IMP_LOTE" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_IMP_SALDO_CONTA_LOTE" tableName="IMP_SALDO_CONTA">
            <column name="LOTE_ID"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
