    </changeSet>
    <changeSet id="2" author="axctg3">
        <addForeignKeyConstraint baseColumnNames="MUNICIPIO_ID" baseTableName="EMPRESA"
                                 constraintName="FK_EMPRESA_ON_MUNICIPIO" referencedColumnNames="ID"
                                 referencedTableName="MUNICIPIO"/>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <addForeignKeyConstraint baseColumnNames="TIPO_LOGRADOURO_ID" baseTableName="EMPRESA"
                                 constraintName="FK_EMPRESA_ON_TIPO_LOGRADOURO" referencedColumnNames="ID"
                                 referencedTableName="TIPO_LOGRADOURO"/>
    </changeSet>
</databaseChangeLog>
