            <column name="IND_NIRE" type="INT"/>
            <column name="IND_FIN_ESC" type="INT"/>
            <column name="IND_GRANDE_PORTE" type="INT"/>
            <column name="TIP_ECD" type="INT"/>
            <column name="COD_SCP" type="BIGINT"/>
            <column name="IDENT_MF" type="BOOLEAN"/>
            <column name="IND_ESC_CONS" type="BOOLEAN"/>
            <column name="IND_CENTRALIZADA" type="INT"/>
            <column name="IND_MUDANCA_PC" type="INT"/>
