            <column name="CPF_CONTABILISTA" type="VARCHAR(11)"/>
            <column name="COD_ASSIN_CONTABILISTA" type="INT"/>
            <column name="EMAIL_CONTABILISTA" type="VARCHAR(60)"/>
            <column name="FONE_CONTABILISTA" type="VARCHAR(14)"/>
            <column name="INSC_CRC" type="VARCHAR(20)"/>
            <column name="NUM_SEQ_CRC" type="VARCHAR(20)"/>
            <column name="DT_CRC" type="DATE"/>
            <column name="UF_CRC" type="VARCHAR(2)"/>
