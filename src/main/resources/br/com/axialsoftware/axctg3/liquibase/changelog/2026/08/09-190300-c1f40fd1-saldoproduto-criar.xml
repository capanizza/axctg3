<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/09-190300-c1f40fd1-saldoproduto-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="SALDO_PRODUTO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_SALDO_PRODUTO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="PRODUTO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="DATA" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="SALDO" type="DECIMAL(19, 3)">
                <constraints nullable="false"/>
            </column>
            <column name="VALOR_UNITARIO" type="DECIMAL(19, 6)">
                <constraints nullable="false"/>
            </column>
            <column name="VALOR" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_SALDO_PRODUTO_PRODUTO" tableName="SALDO_PRODUTO">
            <column name="PRODUTO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="PRODUTO_ID" baseTableName="SALDO_PRODUTO"
                                 constraintName="FK_SALDO_PRODUTO_ON_PRODUTO" referencedColumnNames="ID"
                                 referencedTableName="PRODUTO"/>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_SALDO_PRODUTO_DATA" tableName="SALDO_PRODUTO">
            <column name="DATA"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
