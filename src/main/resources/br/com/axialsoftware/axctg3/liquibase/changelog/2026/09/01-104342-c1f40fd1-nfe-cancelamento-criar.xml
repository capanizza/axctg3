<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/09/01-104342-c1f40fd1-nfe-cancelamento-criar.xml">
    <!--
        Campos do evento de cancelamento (tpEvento 110111 — service/fiscal/NfeCancelamentoService).
        Grupo próprio, separado de PROT_*: preserva o protocolo de autorização original
        (PROT_N_PROT) mesmo depois de cancelada, já que o protocolo do EVENTO de
        cancelamento é um número diferente. Todos nullable: só preenchidos quando a NFe é
        efetivamente cancelada.
    -->
    <changeSet id="1" author="axctg3">
        <addColumn tableName="NFE">
            <column name="CANC_C_STAT" type="INT"/>
            <column name="CANC_X_MOTIVO" type="VARCHAR(255)"/>
            <column name="CANC_N_PROT" type="VARCHAR(15)"/>
            <column name="CANC_DH_REG_EVENTO" type="${offsetDateTime.type}"/>
            <column name="CANC_X_JUST" type="VARCHAR(255)"/>
            <column name="CANC_XML_RETORNO" type="CLOB"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
