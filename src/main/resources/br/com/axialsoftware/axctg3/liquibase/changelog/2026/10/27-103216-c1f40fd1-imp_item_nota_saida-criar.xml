<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/10/27-103216-c1f40fd1-imp_item_nota_saida-criar.xml">
    <!-- Item de nota de saída do legado num lote de importação, gravado pelo exportador do projeto Axial; a tela
         ImpLote.list confere e importa. -->
    <changeSet id="1" author="axctg3">
        <createTable tableName="IMP_ITEM_NOTA_SAIDA">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_ITEM_NOTA_SAIDA"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LOTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="REGISTRO" type="INT"/>
            <column name="PAI" type="INT"/>
            <column name="PRODUTO" type="INT"/>
            <column name="QUANTIDADE" type="DECIMAL(19, 8)"/>
            <column name="VALOR_UNITARIO" type="DECIMAL(19, 8)"/>
            <column name="PORC_DESCONTO" type="DECIMAL(19, 8)"/>
            <column name="DESCONTO" type="DECIMAL(19, 8)"/>
            <column name="BASE_ICMS" type="DECIMAL(19, 8)"/>
            <column name="ALIQ_ICMS" type="DECIMAL(19, 8)"/>
            <column name="VALOR_ICMS" type="DECIMAL(19, 8)"/>
            <column name="BASE_IPI" type="DECIMAL(19, 8)"/>
            <column name="ALIQ_IPI" type="DECIMAL(19, 8)"/>
            <column name="VALOR_IPI" type="DECIMAL(19, 8)"/>
            <column name="BASE_SUBSTITUICAO" type="DECIMAL(19, 8)"/>
            <column name="VALOR_SUBSTITUICAO" type="DECIMAL(19, 8)"/>
            <column name="CFOP" type="INT"/>
            <column name="CST" type="VARCHAR(255)"/>
            <column name="FRETE" type="DECIMAL(19, 8)"/>
            <column name="SEGURO" type="DECIMAL(19, 8)"/>
            <column name="PESO_LIQUIDO" type="DECIMAL(19, 8)"/>
            <column name="PESO_BRUTO" type="DECIMAL(19, 8)"/>
            <column name="COMPL_PRODUTO" type="CLOB"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="IMP_ITEM_NOTA_SAIDA" baseColumnNames="LOTE_ID"
                                 constraintName="FK_IMP_ITEM_NOTA_SAIDA_ON_LOTE"
                                 referencedTableName="IMP_LOTE" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_IMP_ITEM_NOTA_SAIDA_LOTE" tableName="IMP_ITEM_NOTA_SAIDA">
            <column name="LOTE_ID"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
