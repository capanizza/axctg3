<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/14-155546-c1f40fd1-contacontabil-contareferencial-vincular.xml">
    <!-- ContaContabil.codContaRef era um texto livre sem validação (nunca vinculado a nenhuma
         tabela) — vira referência de verdade pra CONTA_REFERENCIAL. Sem migração de dado: não há
         correspondência automática segura entre o texto digitado e um código da tabela nova. -->
    <changeSet id="1" author="axctg3">
        <dropColumn tableName="CONTA_CONTABIL" columnName="COD_CONTA_REF"/>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <addColumn tableName="CONTA_CONTABIL">
            <column name="CONTA_REFERENCIAL_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_CONTA_CONTABIL_CONTA_REFERENCIAL" tableName="CONTA_CONTABIL">
            <column name="CONTA_REFERENCIAL_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CONTA_REFERENCIAL_ID" baseTableName="CONTA_CONTABIL"
                                  constraintName="FK_CONTA_CONTABIL_ON_CONTA_REFERENCIAL" referencedColumnNames="ID"
                                  referencedTableName="CONTA_REFERENCIAL"/>
    </changeSet>
</databaseChangeLog>
