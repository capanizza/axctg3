<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/03-081056-c1f40fd1.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="LANCAMENTO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_LANCAMENTO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="NUMERO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ANO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="MES" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DIA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="COD_EMPRESA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DATA_LANCAMENTO" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="CONTA_DEVEDORA_ID" type="UUID"/>
            <column name="CONTA_CREDORA_ID" type="UUID"/>
            <column name="CENTRO_CUSTO_ID" type="UUID"/>
            <column name="HISTORICO_CONTABIL_ID" type="UUID"/>
            <column name="COMPLEMENTO_HISTORICO" type="CLOB"/>
            <column name="ORIGEM" type="VARCHAR(25)"/>
            <column name="VALOR" type="DECIMAL(19, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_LANCAMENTO_CENTRO_CUSTO" tableName="LANCAMENTO">
            <column name="CENTRO_CUSTO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CENTRO_CUSTO_ID" baseTableName="LANCAMENTO"
                                 constraintName="FK_LANCAMENTO_ON_CENTRO_CUSTO" referencedColumnNames="ID"
                                 referencedTableName="CENTRO_CUSTO"/>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_LANCAMENTO_CONTA_CREDORA" tableName="LANCAMENTO">
            <column name="CONTA_CREDORA_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CONTA_CREDORA_ID" baseTableName="LANCAMENTO"
                                 constraintName="FK_LANCAMENTO_ON_CONTA_CREDORA" referencedColumnNames="ID"
                                 referencedTableName="CONTA_CONTABIL"/>
    </changeSet>
    <changeSet id="4" author="axctg3">
        <createIndex indexName="IDX_LANCAMENTO_CONTA_DEVEDORA" tableName="LANCAMENTO">
            <column name="CONTA_DEVEDORA_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CONTA_DEVEDORA_ID" baseTableName="LANCAMENTO"
                                 constraintName="FK_LANCAMENTO_ON_CONTA_DEVEDORA" referencedColumnNames="ID"
                                 referencedTableName="CONTA_CONTABIL"/>
    </changeSet>
    <changeSet id="5" author="axctg3">
        <createIndex indexName="IDX_LANCAMENTO_DATA" tableName="LANCAMENTO">
            <column name="DATA_LANCAMENTO"/>
        </createIndex>
    </changeSet>
    <changeSet id="6" author="axctg3">
        <createIndex indexName="IDX_LANCAMENTO_HISTORICO_CONTABIL" tableName="LANCAMENTO">
            <column name="HISTORICO_CONTABIL_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="HISTORICO_CONTABIL_ID" baseTableName="LANCAMENTO"
                                 constraintName="FK_LANCAMENTO_ON_HISTORICO_CONTABIL" referencedColumnNames="ID"
                                 referencedTableName="HISTORICO_CONTABIL"/>
    </changeSet>
    <changeSet id="7" author="axctg3" dbms="postgresql">
        <createIndex indexName="IDX_LANCAMENTO_UNQ" tableName="LANCAMENTO" unique="true">
            <column name="NUMERO"/>
            <column name="ANO"/>
            <column name="MES"/>
            <column name="COD_EMPRESA"/>
        </createIndex>

        <modifySql>
            <append value="where DELETED_DATE is null"/>
        </modifySql>
    </changeSet>
</databaseChangeLog>