<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/09-190200-c1f40fd1-produto-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="PRODUTO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_PRODUTO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="CODIGO" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="COD_EMPRESA" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRICAO" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="APELIDO" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="UNIDADE" type="VARCHAR(6)"/>
            <column name="EMBALAGEM" type="VARCHAR(6)"/>
            <column name="QUANT_EMBALAGEM" type="DECIMAL(19, 3)"/>
            <column name="PESO_LIQUIDO" type="DECIMAL(19, 5)"/>
            <column name="PESO_BRUTO" type="DECIMAL(19, 5)"/>
            <column name="GRUPO_PRODUTO_ID" type="UUID"/>
            <column name="TIPO_PRODUTO" type="INT"/>
            <column name="ALIQ_ICMS" type="DECIMAL(7, 2)"/>
            <column name="REDUCAO_ICMS" type="DECIMAL(9, 4)">
                <constraints nullable="false"/>
            </column>
            <column name="ALIQ_IPI" type="DECIMAL(7, 2)"/>
            <column name="CLASSIFICACAO_FISCAL_ID" type="UUID"/>
            <column name="RUA" type="VARCHAR(6)"/>
            <column name="LADO" type="VARCHAR(10)"/>
            <column name="CAIXA" type="INT"/>
            <column name="INATIVO" type="BOOLEAN" defaultValue="FALSE"/>
            <column name="NCM" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_PRODUTO_GRUPO_PRODUTO" tableName="PRODUTO">
            <column name="GRUPO_PRODUTO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="GRUPO_PRODUTO_ID" baseTableName="PRODUTO"
                                 constraintName="FK_PRODUTO_ON_GRUPO_PRODUTO" referencedColumnNames="ID"
                                 referencedTableName="GRUPO_PRODUTO"/>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_PRODUTO_CLASSIFICACAO_FISCAL" tableName="PRODUTO">
            <column name="CLASSIFICACAO_FISCAL_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="CLASSIFICACAO_FISCAL_ID" baseTableName="PRODUTO"
                                 constraintName="FK_PRODUTO_ON_CLASSIFICACAO_FISCAL" referencedColumnNames="ID"
                                 referencedTableName="CLASSIFICACAO_FISCAL"/>
    </changeSet>
    <changeSet id="4" author="axctg3" dbms="postgresql">
        <createIndex indexName="IDX_PRODUTO_UNQ" tableName="PRODUTO" unique="true">
            <column name="CODIGO"/>
            <column name="COD_EMPRESA"/>
        </createIndex>

        <modifySql>
            <append value="where DELETED_DATE is null"/>
        </modifySql>
    </changeSet>
</databaseChangeLog>
