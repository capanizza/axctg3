            <column name="CONTA_CREDORA" type="VARCHAR(25)"/>
            <column name="GRAU_FECHAMENTO" type="INT"/>
            <column name="CONTA_INICIAL" type="VARCHAR(25)"/>
            <column name="CONTA_FINAL" type="VARCHAR(25)"/>
            <column name="LISTAGEM_SINTETICA" type="BOOLEAN"/>
            <column name="DATA_DEPRECIACAO" type="DATE"/>
            <column name="HISTORICO_DEPRECIACAO" type="INT"/>
            <column name="ORIGEM" type="VARCHAR(25)"/>
            <column name="DATA_LANCAMENTO_INICIAL" type="DATE"/>
            <column name="DATA_LANCAMENTO_FINAL" type="DATE"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <addForeignKeyConstraint baseColumnNames="USER_ID" baseTableName="CONFIG_REL"
