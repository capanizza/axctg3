<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/10/20-155048-c1f40fd1-imp_movimento_banco-criar.xml">
    <!-- Movimentos bancários do legado (MOVBANCO) num lote de importação, gravados pelo
         exportador do projeto Axial; a tela ImpLote.list confere e importa. -->
    <changeSet id="1" author="axctg3">
        <createTable tableName="IMP_MOVIMENTO_BANCO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_MOVIMENTO_BANCO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LOTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="REGISTRO" type="INT"/>
            <column name="DATA" type="DATE"/>
            <column name="HISTORICO" type="INT"/>
            <column name="BANCO" type="INT"/>
            <column name="DOCUMENTO" type="VARCHAR(255)"/>
            <column name="DESCRICAO" type="VARCHAR(255)"/>
            <column name="VALOR" type="DECIMAL(19, 2)"/>
            <column name="CHEQUE" type="INT"/>
            <column name="ENTRADA" type="VARCHAR(255)"/>
            <column name="TIPO_SALDO" type="VARCHAR(255)"/>
            <column name="COD_CONTABIL" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="IMP_MOVIMENTO_BANCO" baseColumnNames="LOTE_ID"
                                 constraintName="FK_IMP_MOVIMENTO_BANCO_ON_LOTE"
                                 referencedTableName="IMP_LOTE" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_IMP_MOVIMENTO_BANCO_LOTE" tableName="IMP_MOVIMENTO_BANCO">
            <column name="LOTE_ID"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
