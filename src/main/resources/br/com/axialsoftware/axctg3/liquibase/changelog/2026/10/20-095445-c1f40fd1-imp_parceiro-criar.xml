<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/10/20-095445-c1f40fd1-imp_parceiro-criar.xml">
    <!-- Parceiros do legado (PARCEIRO) num lote de importação, gravados pelo
         exportador do projeto Axial; a tela ImpLote.list confere e importa. -->
    <changeSet id="1" author="axctg3">
        <createTable tableName="IMP_PARCEIRO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_PARCEIRO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LOTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CODIGO" type="BIGINT"/>
            <column name="RAZAO" type="VARCHAR(255)"/>
            <column name="APELIDO" type="VARCHAR(255)"/>
            <column name="CNPJ" type="VARCHAR(255)"/>
            <column name="INSCRICAO" type="VARCHAR(255)"/>
            <column name="LOGRADOURO" type="VARCHAR(255)"/>
            <column name="NUMERO" type="INT"/>
            <column name="COMPLEMENTO" type="VARCHAR(255)"/>
            <column name="BAIRRO" type="VARCHAR(255)"/>
            <column name="CEP" type="VARCHAR(255)"/>
            <column name="MUNICIPIO" type="INT"/>
            <column name="ESTADO" type="VARCHAR(255)"/>
            <column name="TELEFONE" type="VARCHAR(255)"/>
            <column name="CONTATO" type="VARCHAR(255)"/>
            <column name="OBSERVACAO" type="CLOB"/>
            <column name="CLIENTE" type="VARCHAR(255)"/>
            <column name="FORNECEDOR" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="IMP_PARCEIRO" baseColumnNames="LOTE_ID"
                                 constraintName="FK_IMP_PARCEIRO_ON_LOTE"
                                 referencedTableName="IMP_LOTE" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_IMP_PARCEIRO_LOTE" tableName="IMP_PARCEIRO">
            <column name="LOTE_ID"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
