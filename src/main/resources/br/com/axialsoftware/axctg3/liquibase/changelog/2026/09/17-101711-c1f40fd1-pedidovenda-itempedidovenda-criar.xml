            </column>
            <column name="ITEM" type="INT"/>
            <column name="PRODUTO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CFOP" type="INT"/>
            <column name="CST" type="VARCHAR(4)"/>
            <column name="COD_CLASS_TRIB" type="INT"/>
            <column name="QUANTIDADE" type="DECIMAL(19, 3)"/>
            <column name="VALOR_UNITARIO" type="DECIMAL(19, 6)"/>
        </createTable>
    </changeSet>

