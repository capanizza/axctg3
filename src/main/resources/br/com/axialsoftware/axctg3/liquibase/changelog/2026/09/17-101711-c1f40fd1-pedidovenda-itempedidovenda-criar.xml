    <!-- Índice único NUMERO+COD_EMPRESA+ESPECIE+SERIE, mesmo padrão final de NOTA_SAIDA
         (cada série tem sua própria numeração). Postgres usa índice parcial (soft
         delete); HSQLDB (testes) não suporta índice parcial, então cobre também as
         linhas com soft delete. -->
    <changeSet id="11" author="axctg3" dbms="postgresql">
        <createIndex indexName="IDX_PEDIDO_VENDA_UNQ" tableName="PEDIDO_VENDA" unique="true">
            <column name="NUMERO"/>
            <column name="COD_EMPRESA"/>
            <column name="ESPECIE"/>
            <column name="SERIE"/>
        </createIndex>

        <modifySql>
            <append value="where DELETED_DATE is null"/>
        </modifySql>
    </changeSet>

    <changeSet id="12" author="axctg3" dbms="hsqldb">
        <createIndex indexName="IDX_PEDIDO_VENDA_UNQ" tableName="PEDIDO_VENDA" unique="true">
            <column name="NUMERO"/>
            <column name="COD_EMPRESA"/>
            <column name="ESPECIE"/>
            <column name="SERIE"/>
        </createIndex>
    </changeSet>

