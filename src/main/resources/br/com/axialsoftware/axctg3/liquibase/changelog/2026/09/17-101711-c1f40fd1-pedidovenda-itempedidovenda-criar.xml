            <column name="NATUREZA_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CONDICAO_PAGAMENTO_ID" type="UUID"/>
            <column name="BANCO_ID" type="UUID"/>
            <column name="TRANSPORTADORA_ID" type="UUID"/>
            <column name="MOD_FRETE" type="INT"/>
            <column name="VENDEDOR_ID" type="UUID"/>
            <column name="CLASS_TRIB_ID" type="UUID"/>
            <column name="MENSAGEM_ID" type="UUID"/>
            <column name="COMPLEMENTO_MENSAGEM" type="CLOB"/>
            <column name="FRETE" type="DECIMAL(19, 2)"/>
            <column name="SEGURO" type="DECIMAL(19, 2)"/>
            <column name="DESPESAS" type="DECIMAL(19, 2)"/>
            <column name="DESCONTO" type="DECIMAL(19, 2)"/>
            <column name="PESO_LIQUIDO" type="DECIMAL(19, 5)"/>
            <column name="PESO_BRUTO" type="DECIMAL(19, 5)"/>
            <column name="CANCELADO" type="BOOLEAN" defaultValue="FALSE"/>
        </createTable>
    </changeSet>

