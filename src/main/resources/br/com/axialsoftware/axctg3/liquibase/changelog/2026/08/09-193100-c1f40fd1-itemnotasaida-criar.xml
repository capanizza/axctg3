<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/08/09-193100-c1f40fd1-itemnotasaida-criar.xml">
    <changeSet id="1" author="axctg3">
        <createTable tableName="ITEM_NOTA_SAIDA">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_ITEM_NOTA_SAIDA"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="NOTA_SAIDA_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ITEM" type="INT"/>
            <column name="PRODUTO_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="QUANTIDADE" type="DECIMAL(19, 3)"/>
            <column name="VALOR_UNITARIO" type="DECIMAL(19, 6)"/>
            <column name="VALOR_DESCONTO" type="DECIMAL(19, 2)"/>
            <column name="PORC_DESCONTO" type="DECIMAL(19, 2)"/>
            <column name="BASE_ICMS" type="DECIMAL(19, 2)"/>
            <column name="ALIQ_ICMS" type="DECIMAL(19, 2)"/>
            <column name="VALOR_ICMS" type="DECIMAL(19, 2)"/>
            <column name="BASE_IPI" type="DECIMAL(19, 2)"/>
            <column name="ALIQ_IPI" type="DECIMAL(19, 2)"/>
            <column name="VALOR_IPI" type="DECIMAL(19, 2)"/>
            <column name="BASE_ST" type="DECIMAL(19, 2)"/>
            <column name="VALOR_ST" type="DECIMAL(19, 2)"/>
            <column name="FRETE" type="DECIMAL(19, 2)"/>
            <column name="SEGURO" type="DECIMAL(19, 2)"/>
            <column name="DESPESAS" type="DECIMAL(19, 2)"/>
            <column name="CFOP" type="INT"/>
            <column name="CST" type="VARCHAR(4)"/>
            <column name="PESO_LIQUIDO" type="DECIMAL(19, 5)"/>
            <column name="PESO_BRUTO" type="DECIMAL(19, 5)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="axctg3">
        <createIndex indexName="IDX_ITEM_NOTA_SAIDA_NOTA_SAIDA" tableName="ITEM_NOTA_SAIDA">
            <column name="NOTA_SAIDA_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="NOTA_SAIDA_ID" baseTableName="ITEM_NOTA_SAIDA"
                                 constraintName="FK_ITEM_NOTA_SAIDA_ON_NOTA_SAIDA" referencedColumnNames="ID"
                                 referencedTableName="NOTA_SAIDA"/>
    </changeSet>
    <changeSet id="3" author="axctg3">
        <createIndex indexName="IDX_ITEM_NOTA_SAIDA_PRODUTO" tableName="ITEM_NOTA_SAIDA">
            <column name="PRODUTO_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="PRODUTO_ID" baseTableName="ITEM_NOTA_SAIDA"
                                 constraintName="FK_ITEM_NOTA_SAIDA_ON_PRODUTO" referencedColumnNames="ID"
                                 referencedTableName="PRODUTO"/>
    </changeSet>
</databaseChangeLog>
