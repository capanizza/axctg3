<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="br/com/axialsoftware/axctg3/liquibase/changelog/2026/10/27-094054-c1f40fd1-imp_produto-criar.xml">
    <!-- Produto do legados num lote de importação, gravados pelo exportador do projeto Axial; a tela
         ImpLote.list confere e importa. -->
    <changeSet id="1" author="axctg3">
        <createTable tableName="IMP_PRODUTO">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_IMP_PRODUTO"/>
            </column>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
            <column name="LOTE_ID" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="CODIGO" type="INT"/>
            <column name="DESCRICAO" type="VARCHAR(255)"/>
            <column name="APELIDO" type="VARCHAR(255)"/>
            <column name="UNIDADE" type="VARCHAR(255)"/>
            <column name="EMBALAGEM" type="VARCHAR(255)"/>
            <column name="QUANT_EMBALAGEM" type="DECIMAL(19, 6)"/>
            <column name="PESO_LIQUIDO" type="DECIMAL(19, 6)"/>
            <column name="PESO_BRUTO" type="DECIMAL(19, 6)"/>
            <column name="ALIQ_ICMS" type="DECIMAL(19, 6)"/>
            <column name="REDUCAO_ICMS" type="DECIMAL(19, 6)"/>
            <column name="ALIQ_IPI" type="DECIMAL(19, 6)"/>
            <column name="GRUPO_PROD" type="INT"/>
            <column name="CLASSIFICACAO" type="INT"/>
            <column name="NCM" type="VARCHAR(255)"/>
            <column name="INATIVO" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="IMP_PRODUTO" baseColumnNames="LOTE_ID"
                                 constraintName="FK_IMP_PRODUTO_ON_LOTE"
                                 referencedTableName="IMP_LOTE" referencedColumnNames="ID"/>
        <createIndex indexName="IDX_IMP_PRODUTO_LOTE" tableName="IMP_PRODUTO">
            <column name="LOTE_ID"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
