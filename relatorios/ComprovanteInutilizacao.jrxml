<?xml version="1.0" encoding="UTF-8"?>
<!-- Comprovante de Inutilização de Numeração de NF-e — não existe leiaute oficial da SEFAZ
     pra esse documento (diferente do DANFE, regido pelo MOC Anexo II): é só um registro
     legível do que foi enviado/homologado, pra arquivo da empresa. Uma folha só, sem tabela
     de itens — preenchida via JREmptyDataSource (ver NfeInutilizacaoComprovanteService),
     mesmo padrão de ContaContabil2.jrxml (relatório "sem dado", só parâmetros). Fonte DejaVu
     Sans Mono, a mais usada no projeto (ver relatorios/*.jrxml). -->
