	<queryString>
		<![CDATA[SELECT bem.valor_atual,
	conta_contabil.codigo,
	conta_contabil.nome
FROM bem
	LEFT OUTER JOIN conta_contabil ON 
	 conta_contabil.id = bem.conta_contabil_id 
WHERE conta_contabil.codigo > '1'
ORDER BY conta_contabil.codigo ASC]]>
	</queryString>
