	<queryString>
		<![CDATA[SELECT bem.depr_acum,
	conta_contabil.codigo,
	conta_contabil.nome
FROM bem
	LEFT OUTER JOIN conta_contabil ON 
	 conta_contabil.id = bem.conta_contabil_depr_id 
WHERE bem.cod_empresa = 1
and bem.taxa_depr > 0
and bem.valor_compra > bem.valor_baixa
ORDER BY conta_contabil.codigo ASC]]>
	</queryString>
