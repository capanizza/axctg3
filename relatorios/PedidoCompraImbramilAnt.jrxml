<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PedidoCompraImbramil" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="NUMERO_PEDIDO" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="TITULO_RELATORIO" class="java.lang.String"/>
	<parameter name="NOME_EMPRESA" class="java.lang.String"/>
	<queryString>
		<![CDATA[select PedidoCompra.Registro
     , PedidoCompra.Usuario
     , PedidoCompra.DataPedido
     , PedidoCompra.DataPrevistaEntrega
     , PedidoCompra.ValorDesconto
     , PedidoCOmpra.ValorFrete
     , PedidoCOmpra.Observacao
     , PedidoCompra.TipoCompra
     , TipoCompra.Nome
     , PedidoCompra.Centro
     , Centro.Nome as NomeCentro
     , PedidoCompra.Parceiro
     , Parceiro.Razao
     , Parceiro.Apelido
     , Parceiro.Endereco
     , Parceiro.Numero as NumeroParceiro
     , Parceiro.Bairro
     , Parceiro.Municipio
     , Municipio.Nome as NomeMunicipio
     , Parceiro.Cidade
     , Parceiro.CEP
     , Parceiro.Estado
     , Parceiro.CNPJ
     , Parceiro.Inscr
     , PedidoCompra.Condicao
     , Condicao.Nome as NomeCondicao
     , ItemPedidoCompra.Produto
     , ItemPedidoCompra.DescricaoProduto
     , ItemPedidoCompra.Quantidade
     , ItemPedidoCompra.ValorUnitario
     , ItemPedidoCompra.AliqIPI
     , ItemPedidoCompra.AliqICMS
     , ItemPedidoCompra.DataEntrega
     , ItemPedidoCompra.Moeda
     , Cast(ItemPedidoCompra.Quantidade * ItemPedidoCompra.ValorUnitario  * ItemPedidoCompra.AliqIPI / 100 as Numeric(18, 2)) as ValorIPI
     , Cast(ItemPedidoCompra.Quantidade * ItemPedidoCompra.ValorUnitario as Numeric(18, 2)) as SubTotal
     , Cast(ItemPedidoCompra.ValorUnitario  * 100 / (100 - ItemPedidoCompra.AliqICMS) as Numeric(18, 2)) As ValorComICMS
     , Parceiro.Contato as NomeContato
     , Parceiro.Telefone as FoneContato
     , Produto.Unidade as Unidade
from   PedidoCompra
left join TipoCompra on TipoCompra.Registro = PedidoCompra.TipoCompra
left join Centro on Centro.Registro = PedidoCompra.RegCentro
left join Parceiro on Parceiro.Registro = PedidoCompra.RegParceiro
left join Municipio on Municipio.Codigo = Parceiro.Municipio
left join Condicao on Condicao.Registro = PedidoCompra.RegCondicao
left join ItemPedidoCompra on ItemPedidoCompra.Pai = PedidoCompra.Registro
left join Produto on Produto.Registro = ItemPedidoCompra.RegProduto
where PedidoCompra.Registro = $P{NUMERO_PEDIDO}]]>
	</queryString>
