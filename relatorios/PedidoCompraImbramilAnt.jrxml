	</variable>
	<variable name="VALORICMS" class="java.math.BigDecimal" resetType="Group" resetGroup="Numero" calculation="Sum">
		<variableExpression><![CDATA[$F{QUANTIDADE}.multiply($F{VALORUNITARIO}).multiply($F{ALIQICMS}).divide(new BigDecimal(100))]]></variableExpression>
	</variable>
