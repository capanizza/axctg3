<?xml version="1.0" encoding="UTF-8"?>
<!-- Comprovante de Carta de Correção Eletrônica (CC-e, tpEvento 110110) — não existe leiaute
     oficial da SEFAZ pra esse documento (diferente do DANFE, regido pelo MOC Anexo II): é só
     um registro legível do que foi enviado/homologado, pra arquivo da empresa. Uma folha só,
     sem tabela de itens — preenchida via JREmptyDataSource (ver
     NfeCartaCorrecaoComprovanteService), mesmo padrão de ComprovanteInutilizacao.jrxml. Fonte
     DejaVu Sans Mono, a mais usada no projeto (ver relatorios/*.jrxml). -->
