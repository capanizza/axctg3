    <detail>
        <!-- Leiaute da NT 2026.010 (item 4.3): NCM e cClassTrib entram na descrição, CST/CFOP e
             QTD/UN dividem uma coluna cada, e três colunas de tributos — BASES (ICMS, IBS/CBS, IS,
             IPI), ALÍQUOTAS e VALORES (ICMS/CBS, IBS UF/IPI, IBS MUN/IS, aos pares como no modelo
             da NT). Rótulos fixos aqui; valores já formatados em NfeDanfeService, uma linha por
             tributo, em branco quando o grupo do tributo não existe no XML do item. Altura
             mínima de 4 linhas (o que a coluna BASES ocupa); a descrição cresce
             (textAdjust="StretchHeight") e as demais acompanham (RelativeToTallestObject). -->
        <band height="25">
            <textField>
                <reportElement x="0" y="0" width="38" height="25" stretchType="RelativeToTallestObject" uuid="a1b2c3d4-0004-0001-0001-00000000002e"/>
                    <box leftPadding="1" rightPadding="1" topPadding="1"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Top"><font fontName="DejaVu Serif Condensed" size="5"/></textElement>
                <textFieldExpression><![CDATA[$F{codProd}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="38" y="0" width="121" height="25" uuid="a1b2c3d4-0004-0001-0001-00000000002f"/>
                    <box leftPadding="1" rightPadding="1" topPadding="1"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Top"><font fontName="DejaVu Serif Condensed" size="5"/></textElement>
                <textFieldExpression><![CDATA[$F{descProd}
+ "\n[NCM " + ($F{ncm} == null ? "" : $F{ncm}) + "]"
+ ($F{codClassTrib} == null ? "" : " [cClassTrib " + $F{codClassTrib} + "]")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="159" y="0" width="24" height="25" stretchType="RelativeToTallestObject" uuid="a1b2c3d4-0004-0001-0001-000000000030"/>
                    <box leftPadding="1" rightPadding="1" topPadding="1"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="DejaVu Serif Condensed" size="5"/></textElement>
                <textFieldExpression><![CDATA[($F{cst} == null ? "" : $F{cst}) + "\n" + ($F{cfop} == null ? "" : String.format("%04d", $F{cfop}))]]></textFieldExpression>
            </textField>
            <textField>
