<?xml version="1.0" encoding="UTF-8"?>
<!-- DANFE (Documento Auxiliar da Nota Fiscal Eletrônica) — modelo 55, retrato.
     Escrito à mão (sem Jaspersoft Studio) seguindo o leiaute do MOC 7.0, Anexo II (Manual de
     Especificações Técnicas do DANFE e Código de Barras — CONFAZ). Fonte Times New Roman
     (item 3.7 do Anexo II exige Times New Roman ou Courier New) e tamanhos mínimos por campo
     conforme itens 3.7.1 (rótulos de quadro, 5pt negrito caixa-alta — aqui 6pt), 3.7.4 (bloco
     de identificação DANFE/nº/série/folha, 10pt negrito), 3.7.5 (chave de acesso, negrito) e
     3.7.6 (dados do emitente: razão social 12pt negrito, demais dados 8pt negrito). O item
     3.7.9 ("demais campos", 10pt) não foi aplicado na tabela de itens/cálculo do imposto/
     transportador/duplicatas — conferido contra um DANFE oficial real (ACBr) que usa ~5,9pt
     nessas áreas, então manter compacto aqui é consistente com a prática do mercado.
     A disposição dos quadros segue o Anexo III.02 (A4 retrato, folhas soltas) — não é livre
     (item 3.6.3: "a disposição de campos obrigatoriamente obedece ao disposto no anexo").
     NFC-e (modelo 65) fora de escopo — ver NfeDanfeService. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:c="http://jasperreports.sourceforge.net/jasperreports/components"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
              name="Danfe" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-0001-0001-0001-000000000001">

    <!-- Uma duplicata por registro — cada "célula" do jr:list de FATURA/DUPLICATAS abaixo
         (5 colunas, altura variável: nota com poucas parcelas não desperdiça espaço, nota com
         muitas quebra em mais linhas em vez de estourar uma caixa de altura fixa). -->
    <subDataset name="DuplicatasDataset">
        <field name="numDup" class="java.lang.String"/>
        <field name="dataVenc" class="java.lang.String"/>
        <field name="valorDup" class="java.math.BigDecimal"/>
    </subDataset>

    <parameter name="LOGO" class="java.lang.String"/>
    <parameter name="CHAVE" class="java.lang.String"/>
    <parameter name="CHAVE_FORMATADA" class="java.lang.String"/>
    <parameter name="NAT_OP" class="java.lang.String"/>
    <parameter name="NUMERO_NF" class="java.lang.Integer"/>
    <parameter name="SERIE" class="java.lang.Integer"/>
    <parameter name="DH_EMI" class="java.lang.String"/>
    <parameter name="DH_SAI_ENT" class="java.lang.String"/>
    <parameter name="TP_NF_DESC" class="java.lang.String"/>
    <parameter name="TP_AMB_DESC" class="java.lang.String"/>
    <parameter name="PROT_N_PROT" class="java.lang.String"/>
    <parameter name="PROT_DH_RECBTO" class="java.lang.String"/>
    <parameter name="EMIT_CNPJ" class="java.lang.String"/>
    <parameter name="EMIT_X_NOME" class="java.lang.String"/>
    <parameter name="EMIT_X_FANT" class="java.lang.String"/>
    <parameter name="EMIT_ENDERECO" class="java.lang.String"/>
    <parameter name="EMIT_MUN_UF" class="java.lang.String"/>
    <parameter name="EMIT_CEP" class="java.lang.String"/>
    <parameter name="EMIT_FONE" class="java.lang.String"/>
    <parameter name="EMIT_IE" class="java.lang.String"/>
    <parameter name="DEST_DOC" class="java.lang.String"/>
    <parameter name="DEST_X_NOME" class="java.lang.String"/>
    <parameter name="DEST_ENDERECO" class="java.lang.String"/>
    <parameter name="DEST_MUN_UF" class="java.lang.String"/>
    <parameter name="DEST_CEP" class="java.lang.String"/>
    <parameter name="DEST_FONE" class="java.lang.String"/>
    <parameter name="DEST_IE" class="java.lang.String"/>
    <parameter name="TRANSP_X_NOME" class="java.lang.String"/>
    <parameter name="TRANSP_ENDERECO" class="java.lang.String"/>
    <parameter name="TRANSP_MUN_UF" class="java.lang.String"/>
    <parameter name="TRANSP_DOC" class="java.lang.String"/>
    <parameter name="TRANSP_IE" class="java.lang.String"/>
    <parameter name="MOD_FRETE_DESC" class="java.lang.String"/>
    <parameter name="VEIC_PLACA_UF" class="java.lang.String"/>
    <parameter name="VOLUMES" class="java.lang.String"/>
    <parameter name="DUPLICATAS_LIST" class="java.util.List"/>
    <parameter name="VALOR_BC" class="java.lang.String"/>
    <parameter name="VALOR_ICMS" class="java.lang.String"/>
    <parameter name="VALOR_BC_ST" class="java.lang.String"/>
    <parameter name="VALOR_ST" class="java.lang.String"/>
    <parameter name="VALOR_PROD" class="java.lang.String"/>
    <parameter name="VALOR_FRETE" class="java.lang.String"/>
    <parameter name="VALOR_SEG" class="java.lang.String"/>
    <parameter name="VALOR_DESC" class="java.lang.String"/>
    <parameter name="VALOR_OUTRO" class="java.lang.String"/>
    <parameter name="VALOR_IPI" class="java.lang.String"/>
    <parameter name="VALOR_NF" class="java.lang.String"/>
    <!-- Reforma Tributária (NT 2026.010). Os de exibição condicionada (FCP, FCP ST, DIFAL, FCP UF
         destino) chegam "" quando não se aplicam — o quadro fica, só o valor não sai. -->
    <parameter name="EMIT_CRT_DESC" class="java.lang.String"/>
    <parameter name="VALOR_FCP" class="java.lang.String"/>
    <parameter name="VALOR_FCP_ST" class="java.lang.String"/>
    <parameter name="VALOR_ICMS_UF_DEST" class="java.lang.String"/>
    <parameter name="VALOR_FCP_UF_DEST" class="java.lang.String"/>
    <parameter name="VALOR_CBS" class="java.lang.String"/>
    <parameter name="VALOR_IBS_UF" class="java.lang.String"/>
    <parameter name="VALOR_IBS_MUN" class="java.lang.String"/>
    <parameter name="VALOR_IS" class="java.lang.String"/>
    <parameter name="INF_CPL" class="java.lang.String"/>
    <!-- NfeDanfeService só preenche quando Nfe.protCStat == 101 (cancelada pelo evento
         110111 — ver NfeCancelamentoService); null em qualquer outro status, e o printWhenExpression
         abaixo faz a banda de background sumir nesse caso. Bitmap pré-rotacionado (Graphics2D em
         Java), não rotation="Left/Right" do textElement — esse atributo só aceita múltiplos de 90°,
         insuficiente pro carimbo diagonal. -->
    <parameter name="MARCA_CANCELADA" class="java.awt.Image"/>

    <queryString>
        <![CDATA[]]>
    </queryString>

    <field name="codProd" class="java.lang.String"/>
    <field name="descProd" class="java.lang.String"/>
    <field name="ncm" class="java.lang.String"/>
    <field name="cst" class="java.lang.String"/>
    <field name="cfop" class="java.lang.Integer"/>
    <field name="unCom" class="java.lang.String"/>
    <field name="quantCom" class="java.math.BigDecimal"/>
    <field name="valorUnCom" class="java.math.BigDecimal"/>
    <field name="valorProd" class="java.math.BigDecimal"/>
    <field name="baseIcms" class="java.math.BigDecimal"/>
    <field name="valorIcms" class="java.math.BigDecimal"/>
    <field name="valorIpi" class="java.math.BigDecimal"/>
    <field name="aliqIcms" class="java.math.BigDecimal"/>
    <field name="codClassTrib" class="java.lang.String"/>
    <field name="quantUnTexto" class="java.lang.String"/>
    <field name="basesTexto" class="java.lang.String"/>
    <field name="aliqEsqTexto" class="java.lang.String"/>
    <field name="aliqDirTexto" class="java.lang.String"/>
    <field name="valoresEsqTexto" class="java.lang.String"/>
    <field name="valoresDirTexto" class="java.lang.String"/>

    <!-- Carimbo "NF-e CANCELADA" — banda de fundo (repete atrás de TODAS as páginas,
         diferente de title/summary que só imprimem uma vez): igual à moldura da title band,
         555x802 (columnWidth x altura útil da página). Nenhum quadro do DANFE usa mode="Opaque",
         então o vermelho translúcido do bitmap atravessa por baixo de textos/bordas normalmente. -->
    <background>
        <band height="802">
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle">
                <reportElement x="40" y="270" width="475" height="260" uuid="a1b2c3d4-000a-0001-0001-000000000001">
                    <printWhenExpression><![CDATA[$P{MARCA_CANCELADA} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{MARCA_CANCELADA}]]></imageExpression>
            </image>
        </band>
    </background>

    <title>
        <band height="421" splitType="Stretch">
            <!-- Canhoto — 2ª linha (data/assinatura) mais alta que a 1ª, com o campo de data
                 estreito (15% da largura útil) e o quadro NF-e/Número/Série numa coluna à
                 direita abrangendo a altura das duas linhas, igual ao DANFE oficial. -->
            <textField>
                <reportElement x="0" y="0" width="484" height="20" uuid="a1b2c3d4-0002-0001-0001-000000000001"/>
                    <box leftPadding="2" rightPadding="2"><topPen lineWidth="0.5"/><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                <textFieldExpression><![CDATA["RECEBEMOS DE " + $P{EMIT_X_NOME} + " OS PRODUTOS E/OU SERVIÇOS CONSTANTES DA NOTA FISCAL ELETRÔNICA INDICADA AO LADO."]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="20" width="90" height="26" uuid="a1b2c3d4-0002-0001-0001-000000000002"/>
                    <box leftPadding="2" rightPadding="2"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Top"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                <textFieldExpression><![CDATA["DATA DE RECEBIMENTO"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="90" y="20" width="394" height="26" uuid="a1b2c3d4-0002-0001-0001-000000000003"/>
                    <box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Top"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                <textFieldExpression><![CDATA["IDENTIFICAÇÃO E ASSINATURA DO RECEBEDOR"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="484" y="0" width="71" height="14" uuid="a1b2c3d4-0002-0001-0001-000000000004"/>
                    <box leftPadding="2" rightPadding="2"><topPen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="8" isBold="true"/></textElement>
                <text><![CDATA[NF-e]]></text>
            </staticText>
            <textField>
                <reportElement x="484" y="14" width="71" height="16" uuid="a1b2c3d4-0002-0001-0001-00000000003c"/>
                    <box leftPadding="2" rightPadding="2"><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Nº " + $P{NUMERO_NF}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="484" y="30" width="71" height="16" uuid="a1b2c3d4-0002-0001-0001-00000000003d"/>
                    <box leftPadding="2" rightPadding="2"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.25"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["SÉRIE " + $P{SERIE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="41" width="18" height="12" uuid="a1b2c3d4-0002-0001-0001-000000000006"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Sans Mono" size="10"/></textElement>
                <text><![CDATA[✂]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="47" width="555" height="1" uuid="a1b2c3d4-0002-0001-0001-000000000005"/>
                <graphicElement><pen lineStyle="Dashed"/></graphicElement>
            </line>

            <!-- Emitente / DANFE / Chave de acesso — três quadros da MESMA altura (51 a 133,
                 82pt), cada um com borda completa 0.25 via <rectangle> próprio (não box por
                 campo — some quando um campo não imprime e complica alinhar bordas de alturas
                 diferentes). Central (DANFE) mais estreito (110pt); esquerda (emitente, 255pt)
                 e direita (chave, 190pt) mais largos — proporção do DANFE oficial (ACBr).
                 Posições fixas em todo mundo, sem Float: nome/logo/endereço não perseguem mais
                 um ao outro, o nome só ganha uma altura reservada maior (3 linhas) e sobra
                 espaço em branco embaixo se ele for curto. -->

            <!-- Emitente: nome centralizado (até 3 linhas reservadas); logo embaixo à esquerda;
                 endereço/bairro + cidade-UF-CEP + fone centralizados em 3 linhas à direita do
                 logo. Sem CNPJ/IE (já saem na chave de acesso). -->
            <textField>
                <reportElement x="0" y="51" width="255" height="33" uuid="a1b2c3d4-0002-0001-0001-000000000007"/>
                    <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Top"><font fontName="DejaVu Serif Condensed" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{EMIT_X_NOME}]]></textFieldExpression>
            </textField>
            <image scaleImage="FillFrame">
                <reportElement x="0" y="84" width="65" height="49" uuid="a1b2c3d4-0002-0001-0001-000000000006"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="65" y="84" width="190" height="20" uuid="a1b2c3d4-0002-0001-0001-000000000008"/>
                    <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{EMIT_ENDERECO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="65" y="104" width="190" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000009"/>
                    <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{EMIT_MUN_UF} + "  CEP " + $P{EMIT_CEP}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="65" y="117" width="190" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000000a"/>
                    <box leftPadding="2" rightPadding="2"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Fone: " + $P{EMIT_FONE}]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement mode="Transparent" x="0" y="51" width="255" height="82" uuid="a1b2c3d4-0002-0001-0001-00000000003e"/>
                <graphicElement><pen lineWidth="0.25"/></graphicElement>
            </rectangle>

            <!-- DANFE — identificação, tudo centralizado. -->
            <staticText>
                <reportElement x="255" y="51" width="110" height="14" uuid="a1b2c3d4-0002-0001-0001-00000000000d"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="12" isBold="true"/></textElement>
                <text><![CDATA[DANFE]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="65" width="110" height="16" uuid="a1b2c3d4-0002-0001-0001-00000000000e"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                <text><![CDATA[Documento Auxiliar da Nota Fiscal Eletrônica]]></text>
            </staticText>
            <textField>
                <reportElement x="255" y="81" width="110" height="12" uuid="a1b2c3d4-0002-0001-0001-00000000000f"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{TP_NF_DESC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="255" y="93" width="110" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000010"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Nº " + $P{NUMERO_NF}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="255" y="103" width="110" height="10" uuid="a1b2c3d4-0002-0001-0001-00000000003f"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["SÉRIE " + $P{SERIE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="255" y="113" width="70" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000011"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["FOLHA " + $V{PAGE_NUMBER} + "/"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="325" y="113" width="40" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000038"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="255" y="123" width="110" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="5" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TP_AMB_DESC}]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement mode="Transparent" x="255" y="51" width="110" height="82" uuid="a1b2c3d4-0002-0001-0001-000000000040"/>
                <graphicElement><pen lineWidth="0.25"/></graphicElement>
            </rectangle>

            <!-- Chave de acesso / protocolo. -->
            <componentElement>
                <reportElement x="365" y="51" width="190" height="32" uuid="a1b2c3d4-0002-0001-0001-000000000013"/>
                <c:Code128 xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" textPosition="none">
                    <c:codeExpression><![CDATA[$P{CHAVE}]]></c:codeExpression>
                </c:Code128>
            </componentElement>
            <textField>
                <reportElement x="365" y="84" width="190" height="11" uuid="a1b2c3d4-0002-0001-0001-000000000014"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{CHAVE_FORMATADA}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="365" y="95" width="190" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000015"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Serif Condensed" size="5"/></textElement>
                <text><![CDATA[Consulte a autenticidade no portal da NF-e]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="104" width="190" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000016"/>
                <textElement textAlignment="Center"><font fontName="DejaVu Serif Condensed" size="5"/></textElement>
                <text><![CDATA[PROTOCOLO DE AUTORIZAÇÃO DE USO]]></text>
            </staticText>
            <textField>
                <reportElement x="365" y="113" width="190" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000017"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{PROT_N_PROT} + " - " + $P{PROT_DH_RECBTO}]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement mode="Transparent" x="365" y="51" width="190" height="82" uuid="a1b2c3d4-0002-0001-0001-000000000041"/>
                <graphicElement><pen lineWidth="0.25"/></graphicElement>
            </rectangle>

            <!-- Natureza da operação -->
            <staticText>
                <reportElement x="0" y="141" width="555" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000018"/>
                <textElement><font fontName="DejaVu Serif Condensed" size="6" isBold="true"/></textElement>
                <text><![CDATA[NATUREZA DA OPERAÇÃO]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="149" width="555" height="16" uuid="a1b2c3d4-0002-0001-0001-000000000019"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{NAT_OP}]]></textFieldExpression>
            </textField>

            <!-- Quadro do emitente (NT 2026.010, item 4.2): IE, IE do substituto tributário, CNPJ,
                 Código do Regime Tributário (CRT) e o campo reservado "Tipo de Regime de Apuração
                 do IBS e da CBS" — sem tag publicada ainda, a NT manda não imprimir conteúdo nele.
                 IE ST não é gerada por este sistema (sem grupo IEST no XML), então sai vazia. -->
            <textField>
                <reportElement x="0" y="165" width="90" height="13" uuid="a1b2c3d4-000b-0001-0001-000000000001"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                <textFieldExpression><![CDATA["IE: " + $P{EMIT_IE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="90" y="165" width="70" height="13" uuid="a1b2c3d4-000b-0001-0001-000000000002"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                <textFieldExpression><![CDATA["IE Subst. Trib.:"]]></textFieldExpression>
            </textField>
            <textField>
