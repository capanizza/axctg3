            <!-- Fatura / Duplicatas — jr:list em 5 colunas (111pt cada, 5x111=555, sem sobra),
                 altura variável: nominal só 1 linha (13pt); com mais duplicatas, cresce em
                 múltiplos de 13pt e empurra pra baixo tudo que vem depois (Float). Dentro de
                 cada coluna: numDup/dataVenc 20% mais estreitos que o original (22→18, 48→38),
                 a sobra (14pt) foi pro valorDup (41→55) — número e vencimento centralizados,
                 valor à direita (2026-09-22, pedido explícito do usuário). -->
            <staticText>
                <reportElement positionType="Float" x="0" y="239" width="555" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000023"/>
                    <box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.25"/></box>
                <textElement><font fontName="DejaVu Serif Condensed" size="6" isBold="true"/></textElement>
                <text><![CDATA[FATURA / DUPLICATAS]]></text>
            </staticText>
            <componentElement>
                <reportElement x="0" y="247" width="555" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000024">
                    <printWhenExpression><![CDATA[$P{DUPLICATAS_LIST} != null && !$P{DUPLICATAS_LIST}.isEmpty()]]></printWhenExpression>
                </reportElement>
                <c:list xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Horizontal">
                    <datasetRun subDataset="DuplicatasDataset">
                        <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{DUPLICATAS_LIST})]]></dataSourceExpression>
                    </datasetRun>
                    <c:listContents height="13" width="111">
                        <textField>
                            <reportElement x="0" y="0" width="18" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000039"/>
                                <box leftPadding="2" rightPadding="3"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                            <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{numDup}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="18" y="0" width="38" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000003a"/>
                                <box leftPadding="2" rightPadding="2"><bottomPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                            <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{dataVenc}]]></textFieldExpression>
                        </textField>
                        <textField pattern="###,###,##0.00">
                            <reportElement x="56" y="0" width="55" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000003b"/>
                                <box rightPadding="5"><bottomPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                            <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="DejaVu Serif Condensed" size="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{valorDup}]]></textFieldExpression>
                        </textField>
                    </c:listContents>
                </c:list>
            </componentElement>

            <!-- Nota sem duplicatas: uma linha em branco com as mesmas bordas das células da
                 lista, no lugar dela — o quadro FATURA / DUPLICATAS sai sempre, então o
                 layout abaixo não muda entre nota com e sem duplicata (2026-09-24, pedido do
                 usuário; substitui a antiga segunda cópia do bloco inteiro 24pt acima). -->
            <staticText>
                <reportElement x="0" y="247" width="555" height="13" uuid="a1b2c3d4-0002-0001-0001-0000000000d0">
                    <printWhenExpression><![CDATA[$P{DUPLICATAS_LIST} == null || $P{DUPLICATAS_LIST}.isEmpty()]]></printWhenExpression>
                </reportElement>
                    <box><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <text><![CDATA[]]></text>
            </staticText>

            <!-- Totais, na disposição da NT 2026.010 (item 4.1): três quadros. Tudo Float — acompanha a
                 altura real da lista de duplicatas acima. Leiaute FIXO: os campos de exibição
                 condicionada (FCP, FCP ST, DIFAL, FCP UF destino, ICMS/IBS/CBS monofásicos) mantêm
                 quadro e rótulo em toda nota e só deixam o valor em branco quando não se aplicam
                 (mesmo critério do quadro de duplicatas vazio). Monofasia não é modelada em Nfe
                 (fora de escopo, ver NfeItem) — esses oito ficam sempre sem valor.
                 ISSQN (facultativo, "pode ser suprimido quando não se aplicar às operações do
                 emitente") fica de fora: nenhum emitente do sistema fatura serviço na NF-e. -->
