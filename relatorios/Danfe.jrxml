<?xml version="1.0" encoding="UTF-8"?>
<!-- DANFE (Documento Auxiliar da Nota Fiscal Eletrônica) — modelo 55, retrato.
     Escrito à mão (sem Jaspersoft Studio) seguindo o leiaute do MOC 7.0, Anexo II (Manual de
     Especificações Técnicas do DANFE e Código de Barras — CONFAZ). Fonte Times New Roman
     (item 3.7 do Anexo II exige Times New Roman ou Courier New) e tamanhos mínimos por campo
     conforme itens 3.7.1 (rótulos de quadro, 5pt negrito caixa-alta — aqui 6pt), 3.7.4 (bloco
     de identificação DANFE/nº/série/folha, 10pt negrito), 3.7.5 (chave de acesso, negrito) e
     3.7.6 (dados do emitente: razão social 12pt negrito, demais dados 8pt negrito). O item
     3.7.9 ("demais campos", 10pt) não foi aplicado na tabela de itens/cálculo do imposto/
     transportador/duplicatas — conferido contra um DANFE oficial real (ACBr) que usa ~5,9pt
     nessas áreas, então manter compacto aqui é consistente com a prática do mercado.
     A disposição dos quadros segue o Anexo III.02 (A4 retrato, folhas soltas) — não é livre
     (item 3.6.3: "a disposição de campos obrigatoriamente obedece ao disposto no anexo").
     NFC-e (modelo 65) fora de escopo — ver NfeDanfeService. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:c="http://jasperreports.sourceforge.net/jasperreports/components"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd"
              name="Danfe" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1b2c3d4-0001-0001-0001-000000000001">

    <!-- Uma duplicata por registro — cada "célula" do jr:list de FATURA/DUPLICATAS abaixo
         (5 colunas, altura variável: nota com poucas parcelas não desperdiça espaço, nota com
         muitas quebra em mais linhas em vez de estourar uma caixa de altura fixa). -->
    <subDataset name="DuplicatasDataset">
        <field name="numDup" class="java.lang.String"/>
        <field name="dataVenc" class="java.lang.String"/>
        <field name="valorDup" class="java.math.BigDecimal"/>
    </subDataset>

    <parameter name="LOGO" class="java.lang.String"/>
    <parameter name="CHAVE" class="java.lang.String"/>
    <parameter name="CHAVE_FORMATADA" class="java.lang.String"/>
    <parameter name="NAT_OP" class="java.lang.String"/>
    <parameter name="NUMERO_NF" class="java.lang.Integer"/>
    <parameter name="SERIE" class="java.lang.Integer"/>
    <parameter name="DH_EMI" class="java.lang.String"/>
    <parameter name="DH_SAI_ENT" class="java.lang.String"/>
    <parameter name="TP_NF_DESC" class="java.lang.String"/>
    <parameter name="TP_AMB_DESC" class="java.lang.String"/>
    <parameter name="PROT_N_PROT" class="java.lang.String"/>
    <parameter name="PROT_DH_RECBTO" class="java.lang.String"/>
    <parameter name="EMIT_CNPJ" class="java.lang.String"/>
    <parameter name="EMIT_X_NOME" class="java.lang.String"/>
    <parameter name="EMIT_X_FANT" class="java.lang.String"/>
    <parameter name="EMIT_ENDERECO" class="java.lang.String"/>
    <parameter name="EMIT_MUN_UF" class="java.lang.String"/>
    <parameter name="EMIT_CEP" class="java.lang.String"/>
    <parameter name="EMIT_FONE" class="java.lang.String"/>
    <parameter name="EMIT_IE" class="java.lang.String"/>
    <parameter name="DEST_DOC" class="java.lang.String"/>
    <parameter name="DEST_X_NOME" class="java.lang.String"/>
    <parameter name="DEST_ENDERECO" class="java.lang.String"/>
    <parameter name="DEST_MUN_UF" class="java.lang.String"/>
    <parameter name="DEST_CEP" class="java.lang.String"/>
    <parameter name="DEST_FONE" class="java.lang.String"/>
    <parameter name="DEST_IE" class="java.lang.String"/>
    <parameter name="TRANSP_X_NOME" class="java.lang.String"/>
    <parameter name="TRANSP_ENDERECO" class="java.lang.String"/>
    <parameter name="TRANSP_MUN_UF" class="java.lang.String"/>
    <parameter name="TRANSP_DOC" class="java.lang.String"/>
    <parameter name="TRANSP_IE" class="java.lang.String"/>
    <parameter name="MOD_FRETE_DESC" class="java.lang.String"/>
    <parameter name="VEIC_PLACA_UF" class="java.lang.String"/>
    <parameter name="VOLUMES" class="java.lang.String"/>
    <parameter name="DUPLICATAS_LIST" class="java.util.List"/>
    <parameter name="VALOR_BC" class="java.lang.String"/>
    <parameter name="VALOR_ICMS" class="java.lang.String"/>
    <parameter name="VALOR_BC_ST" class="java.lang.String"/>
    <parameter name="VALOR_ST" class="java.lang.String"/>
    <parameter name="VALOR_PROD" class="java.lang.String"/>
    <parameter name="VALOR_FRETE" class="java.lang.String"/>
    <parameter name="VALOR_SEG_DESC_OUTRO" class="java.lang.String"/>
    <parameter name="VALOR_IPI" class="java.lang.String"/>
    <parameter name="VALOR_NF" class="java.lang.String"/>
    <parameter name="INF_CPL" class="java.lang.String"/>

    <queryString>
        <![CDATA[]]>
    </queryString>

    <field name="codProd" class="java.lang.String"/>
    <field name="descProd" class="java.lang.String"/>
    <field name="ncm" class="java.lang.String"/>
    <field name="cst" class="java.lang.String"/>
    <field name="cfop" class="java.lang.Integer"/>
    <field name="unCom" class="java.lang.String"/>
    <field name="quantCom" class="java.math.BigDecimal"/>
    <field name="valorUnCom" class="java.math.BigDecimal"/>
    <field name="valorProd" class="java.math.BigDecimal"/>
    <field name="baseIcms" class="java.math.BigDecimal"/>
    <field name="valorIcms" class="java.math.BigDecimal"/>
    <field name="valorIpi" class="java.math.BigDecimal"/>
    <field name="aliqIcms" class="java.math.BigDecimal"/>

    <title>
        <band height="345" splitType="Stretch">
            <!-- Canhoto -->
            <staticText>
                <reportElement x="0" y="0" width="555" height="20" uuid="a1b2c3d4-0002-0001-0001-000000000001"/>
                    <box leftPadding="2" rightPadding="2"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <text><![CDATA[RECEBEMOS DE (EMITENTE ABAIXO) OS PRODUTOS E/OU SERVIÇOS CONSTANTES DA NOTA FISCAL INDICADA ABAIXO — EMISSÃO E DESTINATÁRIO NO CORPO DO DOCUMENTO]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="20" width="240" height="20" uuid="a1b2c3d4-0002-0001-0001-000000000002"/>
                    <box leftPadding="2" rightPadding="2"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["DATA DE RECEBIMENTO"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="240" y="20" width="155" height="20" uuid="a1b2c3d4-0002-0001-0001-000000000003"/>
                    <box leftPadding="2" rightPadding="2"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["IDENTIFICAÇÃO E ASSINATURA DO RECEBEDOR"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="395" y="20" width="160" height="20" uuid="a1b2c3d4-0002-0001-0001-000000000004"/>
                    <box leftPadding="2" rightPadding="2"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.5"/><rightPen lineWidth="0.25"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Nº " + $P{NUMERO_NF} + "   SÉRIE " + $P{SERIE}]]></textFieldExpression>
            </textField>
            <line>
                <reportElement x="0" y="41" width="555" height="1" uuid="a1b2c3d4-0002-0001-0001-000000000005"/>
                <graphicElement><pen lineStyle="Dashed"/></graphicElement>
            </line>

            <!-- Emitente / DANFE / Chave de acesso -->
            <image scaleImage="FillFrame">
                <reportElement x="0" y="45" width="65" height="35" uuid="a1b2c3d4-0002-0001-0001-000000000006">
                    <printWhenExpression><![CDATA[$P{LOGO} != null]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="65" y="45" width="165" height="16" uuid="a1b2c3d4-0002-0001-0001-000000000007"/>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="12" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{EMIT_X_NOME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="86" width="230" height="11" uuid="a1b2c3d4-0002-0001-0001-000000000008"/>
                <textElement><font fontName="Times New Roman" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{EMIT_ENDERECO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="97" width="230" height="11" uuid="a1b2c3d4-0002-0001-0001-000000000009"/>
                <textElement><font fontName="Times New Roman" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{EMIT_MUN_UF} + "  CEP " + $P{EMIT_CEP}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="108" width="115" height="11" uuid="a1b2c3d4-0002-0001-0001-00000000000a"/>
                <textElement><font fontName="Times New Roman" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Fone: " + $P{EMIT_FONE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="115" y="108" width="115" height="11" uuid="a1b2c3d4-0002-0001-0001-00000000000b"/>
                <textElement><font fontName="Times New Roman" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["IE: " + $P{EMIT_IE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="119" width="230" height="11" uuid="a1b2c3d4-0002-0001-0001-00000000000c"/>
                <textElement><font fontName="Times New Roman" size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["CNPJ: " + $P{EMIT_CNPJ}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="230" y="45" width="155" height="16" uuid="a1b2c3d4-0002-0001-0001-00000000000d"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="13" isBold="true"/></textElement>
                <text><![CDATA[DANFE]]></text>
            </staticText>
            <staticText>
                <reportElement x="230" y="61" width="155" height="20" uuid="a1b2c3d4-0002-0001-0001-00000000000e"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <text><![CDATA[Documento Auxiliar da Nota Fiscal Eletrônica]]></text>
            </staticText>
            <textField>
                <reportElement x="230" y="81" width="155" height="12" uuid="a1b2c3d4-0002-0001-0001-00000000000f"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{TP_NF_DESC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="230" y="93" width="155" height="14" uuid="a1b2c3d4-0002-0001-0001-000000000010"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["Nº " + $P{NUMERO_NF} + "   SÉRIE " + $P{SERIE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="230" y="107" width="120" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000011"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Times New Roman" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA["FOLHA " + $V{PAGE_NUMBER} + "/"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement x="350" y="107" width="35" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000038"/>
                <textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="Times New Roman" size="10" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="230" y="117" width="155" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="6" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{TP_AMB_DESC}]]></textFieldExpression>
            </textField>

            <componentElement>
                <reportElement x="390" y="45" width="165" height="32" uuid="a1b2c3d4-0002-0001-0001-000000000013"/>
                <c:Code128 xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" textPosition="none">
                    <c:codeExpression><![CDATA[$P{CHAVE}]]></c:codeExpression>
                </c:Code128>
            </componentElement>
            <textField>
                <reportElement x="390" y="78" width="165" height="11" uuid="a1b2c3d4-0002-0001-0001-000000000014"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{CHAVE_FORMATADA}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="390" y="89" width="165" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000015"/>
                <textElement textAlignment="Center"><font fontName="Times New Roman" size="5"/></textElement>
                <text><![CDATA[Consulte a autenticidade no portal da NF-e]]></text>
            </staticText>
            <staticText>
                <reportElement x="390" y="98" width="165" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000016"/>
                <textElement textAlignment="Center"><font fontName="Times New Roman" size="5"/></textElement>
                <text><![CDATA[PROTOCOLO DE AUTORIZAÇÃO DE USO]]></text>
            </staticText>
            <textField>
                <reportElement x="390" y="107" width="165" height="10" uuid="a1b2c3d4-0002-0001-0001-000000000017"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="Times New Roman" size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{PROT_N_PROT} + " - " + $P{PROT_DH_RECBTO}]]></textFieldExpression>
            </textField>

            <!-- Natureza da operação -->
            <staticText>
                <reportElement x="0" y="135" width="555" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000018"/>
                <textElement><font fontName="Times New Roman" size="6" isBold="true"/></textElement>
                <text><![CDATA[NATUREZA DA OPERAÇÃO]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="143" width="555" height="16" uuid="a1b2c3d4-0002-0001-0001-000000000019"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="8"/></textElement>
                <textFieldExpression><![CDATA[$P{NAT_OP}]]></textFieldExpression>
            </textField>

            <!-- Destinatário / Remetente -->
            <staticText>
                <reportElement x="0" y="160" width="555" height="8" uuid="a1b2c3d4-0002-0001-0001-00000000001a"/>
                <textElement><font fontName="Times New Roman" size="6" isBold="true"/></textElement>
                <text><![CDATA[DESTINATÁRIO / REMETENTE]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="168" width="350" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000001b"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["Nome/Razão Social: " + $P{DEST_X_NOME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="168" width="205" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000001c"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["CNPJ/CPF: " + $P{DEST_DOC}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="181" width="350" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000001d"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["Endereço: " + $P{DEST_ENDERECO}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="181" width="205" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000001e"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["IE: " + $P{DEST_IE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="194" width="350" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000001f"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["Município/UF: " + $P{DEST_MUN_UF} + "  CEP " + $P{DEST_CEP}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="194" width="205" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000020"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["Fone: " + $P{DEST_FONE}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="207" width="275" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000021"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["Data Emissão: " + $P{DH_EMI}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="275" y="207" width="280" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000022"/>
                    <box leftPadding="2" rightPadding="2"><pen lineWidth="0.5"/><leftPen lineWidth="0.25"/><rightPen lineWidth="0.25"/></box>
                <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                <textFieldExpression><![CDATA["Data Saída/Entrada: " + $P{DH_SAI_ENT}]]></textFieldExpression>
            </textField>

            <!-- Fatura / Duplicatas — jr:list em 5 colunas (111pt cada, 5x111=555, sem sobra),
                 altura variável: nominal só 1 linha (13pt); com mais duplicatas, cresce em
                 múltiplos de 13pt e empurra pra baixo tudo que vem depois (Float). -->
            <staticText>
                <reportElement x="0" y="220" width="555" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000023"/>
                <textElement><font fontName="Times New Roman" size="6" isBold="true"/></textElement>
                <text><![CDATA[FATURA / DUPLICATAS]]></text>
            </staticText>
            <componentElement>
                <reportElement x="0" y="228" width="555" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000024"/>
                <c:list xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports/components http://jasperreports.sourceforge.net/xsd/components.xsd" printOrder="Horizontal">
                    <datasetRun subDataset="DuplicatasDataset">
                        <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRBeanCollectionDataSource($P{DUPLICATAS_LIST})]]></dataSourceExpression>
                    </datasetRun>
                    <c:listContents height="13" width="111">
                        <textField>
                            <reportElement x="0" y="0" width="22" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000039"/>
                                <box leftPadding="2" rightPadding="1"><leftPen lineWidth="0.25"/><bottomPen lineWidth="0.25"/></box>
                            <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{numDup}]]></textFieldExpression>
                        </textField>
                        <textField>
                            <reportElement x="22" y="0" width="48" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000003a"/>
                                <box rightPadding="1"><bottomPen lineWidth="0.25"/></box>
                            <textElement verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{dataVenc}]]></textFieldExpression>
                        </textField>
                        <textField pattern="###,###,##0.00">
                            <reportElement x="70" y="0" width="41" height="13" uuid="a1b2c3d4-0002-0001-0001-00000000003b"/>
                                <box rightPadding="2"><bottomPen lineWidth="0.25"/></box>
                            <textElement textAlignment="Right" verticalAlignment="Middle"><font fontName="Times New Roman" size="6"/></textElement>
                            <textFieldExpression><![CDATA[$F{valorDup}]]></textFieldExpression>
                        </textField>
                    </c:listContents>
                </c:list>
            </componentElement>

            <!-- Cálculo do imposto — positionType Float: acompanha a altura real da lista de
                 duplicatas acima (que varia conforme a quantidade de parcelas). -->
            <staticText>
                <reportElement positionType="Float" x="0" y="244" width="555" height="8" uuid="a1b2c3d4-0002-0001-0001-000000000025"/>
                <textElement><font fontName="Times New Roman" size="6" isBold="true"/></textElement>
                <text><![CDATA[CÁLCULO DO IMPOSTO]]></text>
            </staticText>
            <textField>
                <reportElement positionType="Float" x="0" y="252" width="111" height="13" uuid="a1b2c3d4-0002-0001-0001-000000000026"/>
