				<textField pattern="#,##0.00;-#,##0.00">
					<reportElement x="728" y="70" width="74" height="14" uuid="50154a14-483a-44ed-8294-5cc77ec4d5ef">
						<printWhenExpression><![CDATA[$F{QUANTIDADE}.compareTo( BigDecimal.ZERO ) > 0]]></printWhenExpression>
					</reportElement>
					<box leftPadding="2" rightPadding="2">
						<topPen lineWidth="0.0"/>
						<leftPen lineWidth="0.25"/>
						<bottomPen lineWidth="0.25"/>
						<rightPen lineWidth="0.25"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="Courier New" size="8"/>
					</textElement>
					<textFieldExpression><![CDATA[$V{VALOR}.subtract($F{VALORDESCONTO}).add($V{VALORIPI}).add($F{VALORFRETE})]]></textFieldExpression>
				</textField>
				<textField pattern="#,##0.00;-#,##0.00">
					<reportElement x="728" y="0" width="74" height="14" uuid="52d81a65-9b5a-4c87-bc6a-e4d33c490703">
