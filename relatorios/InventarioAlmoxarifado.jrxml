<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="InventarioAlmoxarifado" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="TITULO_RELATORIO" class="java.lang.String"/>
	<parameter name="NOME_EMPRESA" class="java.lang.String"/>
	<parameter name="DATA_INVENTARIO" class="java.util.Date"/>
	<parameter name="COD_EMPRESA" class="java.lang.Integer"/>
	<parameter name="PRODUTO_INICIAL" class="java.lang.Integer"/>
	<parameter name="PRODUTO_FINAL" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[select RProduto,
       RDescricaoProduto,
       RNometipo,
       RSaldoAtual,
       RCustoAtual,
       RValorAtual
from CalculaInventarioAlmoxarifado($P{PRODUTO_INICIAL}
                                 , $P{PRODUTO_FINAL}
                                 , $P{DATA_INVENTARIO}, $P{COD_EMPRESA})
where RSaldoAtual <> 0]]>
	</queryString>
	<field name="RPRODUTO" class="java.lang.Integer"/>
	<field name="RDESCRICAOPRODUTO" class="java.lang.String"/>
	<field name="RNOMETIPO" class="java.lang.String"/>
	<field name="RSALDOATUAL" class="java.math.BigDecimal"/>
	<field name="RCUSTOATUAL" class="java.math.BigDecimal"/>
	<field name="RVALORATUAL" class="java.math.BigDecimal"/>
	<sortField name="RNOMETIPO"/>
	<sortField name="RDESCRICAOPRODUTO"/>
	<variable name="VALOR" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{RVALORATUAL}]]></variableExpression>
	</variable>
	<variable name="SALDO_GRUPO" class="java.math.BigDecimal" resetType="Group" resetGroup="NomeTipo" calculation="Sum">
		<variableExpression><![CDATA[$F{RSALDOATUAL}]]></variableExpression>
	</variable>
	<variable name="VALOR_GRUPO" class="java.math.BigDecimal" resetType="Group" resetGroup="NomeTipo" calculation="Sum">
		<variableExpression><![CDATA[$F{RVALORATUAL}]]></variableExpression>
	</variable>
