						<bottomPen lineWidth="0.0"/>
					</box>
					<textElement textAlignment="Right" verticalAlignment="Middle">
						<font fontName="Courier New" size="8" isBold="true"/>
					</textElement>
					<textFieldExpression><![CDATA[$V{VALOR_GRUPO}]]></textFieldExpression>
				</textField>
			</band>
		</groupFooter>
	</group>
